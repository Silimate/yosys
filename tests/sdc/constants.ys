read_verilog constants.v
proc
hierarchy -top constants

logger -expect warning "only input ports can be tied" 1
logger -expect warning "is not a get_ports result" 1
sdc -constants -stubs constants_stubs.tcl constants.sdc
logger -check-expected

# en reaches the child, sel[1] the and: both fold; sel[0] is untied, so its mux stays
flatten
opt -full
select -assert-none t:$and
select -assert-count 1 t:$mux

# Each port reads the constant the SDC gave it, at the bit the HDL numbers that way
sat -verify -prove y a -prove z 1'b0 -prove h b[1] -prove u b[2]

# The tied ports stay ports
select -assert-count 1 i:en
select -assert-count 1 i:sel
