# opt_dff -sat proves flops that hold each other constant: neither is inductive alone

# a and b only rise together, so both stay 0
design -reset
read_verilog -sv <<EOT
module test_case (
	input wire clk,
	input wire rst,
	input wire x,
	input wire y,
	output reg a,
	output reg b
);
	always @(posedge clk)
		if (rst) begin
			a <= 1'b0;
			b <= 1'b0;
		end else begin
			a <= b & x;
			b <= a & y;
		end
endmodule
EOT

hierarchy -top test_case
prep
design -save gold

opt_dff
opt_clean -purge
select -assert-count 2 t:$sdff

design -load gold
opt_dff -sat
opt_clean -purge
select -assert-none t:$sdff
design -save gate

design -load gold
design -copy-from gate -as gate test_case
equiv_make test_case gate equiv
equiv_induct equiv
equiv_status -assert


# a ring from init values, beside a flop that toggles: the ring folds, t stays
design -reset
read_verilog -sv <<EOT
module test_case (
	input wire clk,
	input wire en,
	output reg [2:0] c,
	output reg t
);
	initial c = 3'b000;
	initial t = 1'b0;
	always @(posedge clk) begin
		c <= {c[1], c[0], c[2] & en};
		t <= ~t;
	end
endmodule
EOT

hierarchy -top test_case
prep
design -save gold

opt_dff -sat
opt_clean -purge
select -assert-count 1 t:$dff
select -assert-count 1 t:$dff r:WIDTH=1 %i
design -save gate

design -load gold
design -copy-from gate -as gate test_case
equiv_make test_case gate equiv
equiv_induct equiv
equiv_status -assert


# b can rise from y, so a, which only holds while b does, is not constant either
design -reset
read_verilog -sv <<EOT
module test_case (
	input wire clk,
	input wire rst,
	input wire x,
	input wire y,
	output reg a,
	output reg b
);
	always @(posedge clk)
		if (rst) begin
			a <= 1'b0;
			b <= 1'b0;
		end else begin
			a <= b & x;
			b <= a | y;
		end
endmodule
EOT

hierarchy -top test_case
prep
opt_dff -sat
opt_clean -purge
select -assert-count 2 t:$sdff
