# Tests for opt_mux_odc
#
# Each group exercises a specific facet:
#   A: the fold itself, on an OR that takes the mux select as an input.
#   B: the dual, an AND forced low on the select==0 arm.
#   C: the exclusivity guards -- escapes to a port, to the select, or to the
#      opposite arm all make the fold unsound.
#   D: no implication, and -strict.
#   E: batching -- a run applies every fold it finds at once, including folds
#      that land in each other's cones.
#
# The pass deletes the decode that the select already forces, so the structural
# check is that the compares feeding it are gone. equiv_opt cannot be used here:
# this is an observability don't-care, so gold and gate deliberately differ on
# internal nodes and only the module outputs agree. Group A therefore proves
# output equivalence with a miter instead.

# ============================================================================
# Group A: fold an OR that the select forces high
# ============================================================================

# A1: `hit` ORs in the very select that gates the arm, so the two compares
# ahead of it are dead along that arm and must disappear.
log -header "A1: OR forced high by the select"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  wire [3:0] res = hit ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
prep -top top
design -save gold
select -assert-min 1 t:$eq
opt_mux_odc
opt_clean
select -assert-count 0 t:$eq
log -pop

# A2: the fold must preserve the module outputs even though `hit` itself
# changes when v is 0 (the arm is not selected then).
log -header "A2: output equivalence of the A1 fold"
log -push
design -load gold
rename top gate
opt_mux_odc
opt_clean
design -save gate
design -load gold
design -copy-from gate -as gate gate
miter -equiv -flatten top gate miter
hierarchy -top miter
sat -verify -prove trigger 0 miter
log -pop

# ============================================================================
# Group B: the dual, an AND forced low on the select==0 arm
# ============================================================================

# B1: the arm is taken when v is 0, and `blk` ANDs in v, so it is 0 there.
log -header "B1: AND forced low by the select"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire blk = v & ((f == 8'd10) | (f == 8'd20));
  wire [3:0] res = blk ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? byp : res;
endmodule
EOF
prep -top top
select -assert-min 1 t:$eq
opt_mux_odc
opt_clean
select -assert-count 0 t:$eq
log -pop

# ============================================================================
# Group C: exclusivity guards
# ============================================================================

# C1: `hit` also leaves through a module output, so it is observed when v is 0
# and forcing it would change that port.
log -header "C1: forced signal escapes to a port (no fold)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y, output wire hit_o);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  wire [3:0] res = hit ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
  assign hit_o = hit;
endmodule
EOF
prep -top top
opt_mux_odc
opt_clean
select -assert-min 1 t:$eq
log -pop

# C2: `hit` also feeds the opposite arm, which is what the mux produces when
# v is 0, so the fold would corrupt it.
log -header "C2: forced signal feeds the opposite arm (no fold)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  wire [3:0] res = hit ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : {3'b0, hit};
endmodule
EOF
prep -top top
opt_mux_odc
opt_clean
select -assert-min 1 t:$eq
log -pop

# C3: `hit` reaches the arm only through a flip-flop. Forcing it would change
# what the register captures on cycles when the arm is not selected, and that
# stale value is then read on a later cycle when it is.
log -header "C3: forced signal crosses a flip-flop (no fold)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire clk, input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  reg hit_q;
  always @(posedge clk) hit_q <= hit;
  wire [3:0] res = hit_q ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
prep -top top
opt_mux_odc
opt_clean
select -assert-min 1 t:$eq
log -pop

# C4: a partial selection must not have its unselected cells rewritten, even
# though the escape analysis still has to look at the whole module.
log -header "C4: fold outside the selection is left alone"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  wire [3:0] res = hit ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
prep -top top
select t:$add
opt_mux_odc
select -clear
opt_clean
select -assert-min 1 t:$eq
log -pop

# C5: the state element is hidden inside a submodule. opt_boundary keeps
# hierarchy, so the walk has to look inside rather than trust the instance.
log -header "C5: state hidden in a submodule (no fold)"
log -push
design -reset
read_verilog -sv <<EOF
module delay (input wire clk, input wire d, output reg q);
  always @(posedge clk) q <= d;
endmodule

module top (input wire clk, input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  wire hit_d;
  delay u_delay (.clk(clk), .d(hit), .q(hit_d));
  wire [3:0] res = hit_d ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
hierarchy -top top
proc
opt_mux_odc
opt_clean
select -assert-min 1 t:$eq
log -pop

# C6: a purely combinational submodule on the path is fine, and must still
# fold -- otherwise the pass would be useless with opt_boundary enabled.
log -header "C6: combinational submodule still folds"
log -push
design -reset
read_verilog -sv <<EOF
module recode (input wire [3:0] a, output wire [3:0] y);
  assign y = a ^ 4'b1010;
endmodule

module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  wire [3:0] res = hit ? (x + 4'd1) : (x + 4'd2);
  wire [3:0] res_r;
  recode u_recode (.a(res), .y(res_r));
  assign y = v ? res_r : byp;
endmodule
EOF
hierarchy -top top
proc
select -assert-min 1 t:$eq
opt_mux_odc
opt_clean
select -assert-count 0 t:$eq
log -pop

# C7: run before `proc`, so the register is still a process rather than a cell.
# The cell-based index cannot see it, so the module must be skipped outright
# instead of analysed with an incomplete view of its drivers and readers.
log -header "C7: unlowered process in the module (skipped)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire clk, input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  reg hit_q;
  always @(posedge clk) hit_q <= hit;
  wire [3:0] res = hit_q ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
hierarchy -top top
opt_mux_odc
select -assert-min 1 t:$eq
log -pop

# C8: the process is in a submodule this time, so the top itself is lowered and
# only the recursive check can tell that the instance is stateful.
log -header "C8: unlowered process in a submodule (no fold)"
log -push
design -reset
read_verilog -sv <<EOF
module delay (input wire clk, input wire d, output reg q);
  always @(posedge clk) q <= d;
endmodule

module top (input wire clk, input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  wire hit_d;
  delay u_delay (.clk(clk), .d(hit), .q(hit_d));
  wire [3:0] res = hit_d ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
hierarchy -top top
proc top
opt_mux_odc
select -assert-min 1 t:$eq
log -pop

# ============================================================================
# Group D: no implication, and -strict
# ============================================================================

# D1: the select is not an input of the OR, so nothing is forced.
log -header "D1: select does not reach the OR (no fold)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = (f == 8'd10) | (f == 8'd20);
  wire [3:0] res = hit ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
prep -top top
opt_mux_odc
opt_clean
select -assert-min 1 t:$eq
log -pop

# D2: -strict turns the pass off for the formal flow.
log -header "D2: -strict disables the fold"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  wire [3:0] res = hit ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
prep -top top
opt_mux_odc -strict
opt_clean
select -assert-min 1 t:$eq
log -pop

# ============================================================================
# Group E: batching
# ============================================================================
#
# A run decides every fold against one index and then applies them together,
# because re-indexing per fold made the pass quadratic in the number of fold
# sites. That is only sound because a fold cannot invalidate another's
# justification -- it deletes a gate, so it can neither add a reader nor open an
# escape -- so each case here checks the whole batch lands in a single run and
# proves the module outputs with a miter.

# E1: two unrelated sites under two different selects.
log -header "E1: two independent folds in one run"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire w, input wire [7:0] f, input wire [7:0] g,
            input wire [3:0] x, input wire [3:0] b1, input wire [3:0] b2,
            output wire [3:0] y1, output wire [3:0] y2);
  wire h1 = v | (f == 8'd10) | (f == 8'd20);
  wire h2 = w | (g == 8'd30) | (g == 8'd40);
  wire [3:0] r1 = h1 ? (x + 4'd1) : (x + 4'd2);
  wire [3:0] r2 = h2 ? (x + 4'd5) : (x + 4'd6);
  assign y1 = v ? r1 : b1;
  assign y2 = w ? r2 : b2;
endmodule
EOF
prep -top top
design -save gold_e1
select -assert-min 4 t:$eq
opt_mux_odc
opt_clean
select -assert-count 0 t:$eq
log -pop

log -header "E1m: output equivalence of the E1 batch"
log -push
design -load gold_e1
rename top gate
opt_mux_odc
opt_clean
design -save gate_e1
design -load gold_e1
design -copy-from gate_e1 -as gate gate
miter -equiv -flatten top gate miter
hierarchy -top miter
sat -verify -prove trigger 0 miter
log -pop

# E2: one select driving two muxes, so the candidate search and the forward
# walks are shared across the group rather than repeated per mux.
log -header "E2: one select, two muxes"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] b1, input wire [3:0] b2,
            output wire [3:0] y1, output wire [3:0] y2);
  wire h1 = v | (f == 8'd10);
  wire h2 = v | (f == 8'd20);
  wire [3:0] r1 = h1 ? (x + 4'd1) : (x + 4'd2);
  wire [3:0] r2 = h2 ? (x + 4'd5) : (x + 4'd6);
  assign y1 = v ? r1 : b1;
  assign y2 = v ? r2 : b2;
endmodule
EOF
prep -top top
design -save gold_e2
select -assert-min 2 t:$eq
opt_mux_odc
opt_clean
select -assert-count 0 t:$eq
log -pop

log -header "E2m: output equivalence of the E2 batch"
log -push
design -load gold_e2
rename top gate
opt_mux_odc
opt_clean
design -save gate_e2
design -load gold_e2
design -copy-from gate_e2 -as gate gate
miter -equiv -flatten top gate miter
hierarchy -top miter
sat -verify -prove trigger 0 miter
log -pop

# E3: h1 is itself an input of h2, so the batch applies a fold that sits inside
# another fold's input cone -- the case where applying one rewrite could most
# plausibly disturb the other's justification.
log -header "E3: candidate feeding another candidate"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire h1 = v | (f == 8'd10);
  wire h2 = v | (h1 & (f == 8'd20));
  wire [3:0] r = h2 ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? r : byp;
endmodule
EOF
prep -top top
design -save gold_e3
select -assert-min 2 t:$eq
opt_mux_odc
opt_clean
select -assert-count 0 t:$eq
log -pop

log -header "E3m: output equivalence of the E3 batch"
log -push
design -load gold_e3
rename top gate
opt_mux_odc
opt_clean
design -save gate_e3
design -load gold_e3
design -copy-from gate_e3 -as gate gate
miter -equiv -flatten top gate miter
hierarchy -top miter
sat -verify -prove trigger 0 miter
log -pop

# E4: one candidate feeding several arms on the same select. Under the other
# select value every one of those muxes drives its opposite arm, so none of them
# passes the candidate on and the fold is sound -- even though no single arm's
# cone contains all three sites. Matching one mux at a time cannot see that; the
# forward walk decides exclusivity over the whole select at once, which is
# exactly what this case is here to pin down.
log -header "E4: candidate feeding several arms on one select"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] b1, input wire [3:0] b2, input wire [3:0] b3,
            output wire [3:0] y1, output wire [3:0] y2, output wire [3:0] y3);
  wire h = v | (f == 8'd10) | (f == 8'd20);
  wire [3:0] r1 = h ? (x + 4'd1) : (x + 4'd2);
  wire [3:0] r2 = h ? (x + 4'd5) : (x + 4'd6);
  wire [3:0] r3 = h ? (x + 4'd7) : (x + 4'd8);
  assign y1 = v ? r1 : b1;
  assign y2 = v ? r2 : b2;
  assign y3 = v ? r3 : b3;
endmodule
EOF
prep -top top
design -save gold_e4
select -assert-min 1 t:$eq
opt_mux_odc
opt_clean
select -assert-count 0 t:$eq
log -pop

log -header "E4m: output equivalence of the E4 fold"
log -push
design -load gold_e4
rename top gate
opt_mux_odc
opt_clean
design -save gate_e4
design -load gold_e4
design -copy-from gate_e4 -as gate gate
miter -equiv -flatten top gate miter
hierarchy -top miter
sat -verify -prove trigger 0 miter
log -pop

# E5: the dual of E4. One of the sibling muxes on the select takes the candidate
# on its *opposite* arm, so under the other select value that mux does pass it
# on -- and straight to a port. The walk has to cross the mux rather than stop
# at it, which is the only reason it sees the escape at all.
log -header "E5: candidate on a sibling mux's opposite arm (no fold)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, input wire [3:0] alt,
            output wire [3:0] y, output wire [3:0] z);
  wire h = v | (f == 8'd10) | (f == 8'd20);
  wire [3:0] r = h ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? r : byp;
  assign z = v ? alt : {3'b0, h};
endmodule
EOF
prep -top top
opt_mux_odc
opt_clean
select -assert-min 1 t:$eq
log -pop

# ============================================================================
# Group F: the wires the rewrite may not touch, and the search limits
# ============================================================================

# F1: a `keep` wire is observable by construction, whatever the select does, so
# the gate driving it must survive.
log -header "F1: candidate drives a keep wire (no fold)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  (* keep *) wire hit = v | (f == 8'd10);
  wire [3:0] res = hit ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
prep -top top
opt_mux_odc
opt_clean
select -assert-min 1 t:$eq
log -pop

# F2: the per-module walk budget cuts the search short. It may only lose folds,
# so the A1 shape -- which folds with the default budget -- must come through
# untouched when the budget is too small to reach a verdict.
log -header "F2: the walk budget skips candidates instead of mis-folding"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire v, input wire [7:0] f, input wire [3:0] x,
            input wire [3:0] byp, output wire [3:0] y);
  wire hit = v | (f == 8'd10) | (f == 8'd20);
  wire [3:0] res = hit ? (x + 4'd1) : (x + 4'd2);
  assign y = v ? res : byp;
endmodule
EOF
prep -top top
design -save gold_f2
opt_mux_odc -walk-budget 1
opt_clean
select -assert-min 1 t:$eq
design -load gold_f2
opt_mux_odc
opt_clean
select -assert-count 0 t:$eq
log -pop
