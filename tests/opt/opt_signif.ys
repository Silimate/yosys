# Tests for opt_signif.
#
# opt_signif narrows arithmetic operand ports whose upper bits are provably sign
# (or zero) extension, using a forward value-range analysis over the word-level
# operators. wreduce already strips such a prefix, but it decides how much to
# strip by comparing the top two bits for net identity after sigmap, so it only
# fires when the redundant bits are literally the same net. The shapes below hide
# the extension behind a $mux or a $neg, where every upper bit is a distinct net.
#
# Every positive case is proven with equiv_opt -assert, so the structural width
# assertions are backed by a SAT equivalence check rather than inspection alone.
#
# The default type set is $add,$sub,$mul,$neg. Compares are supported but must be
# asked for with -types, so the compare cases below pass it explicitly and C5 pins
# the default.

# ============================================================================
# Group A: Positive rewrites
# ============================================================================

# Test A1: signed multiply over two sign-muxed magnitudes.
#
# Shape:
#   wa = sa ? -$signed({1'b0, ma}) : $signed({1'b0, ma})   (32 bits, ma is 4)
#   wb = sb ? -$signed({1'b0, mb}) : $signed({1'b0, mb})
#   y  = wa * wb
#
# Context widens both operands to 32 bits, but each can only hold [-15, 15], so
# five signed bits suffice and the multiply should become 5x5 instead of 32x32.
log -header "A1: signed multiply over sign-muxed magnitudes"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire signed [31:0] y
);
  wire signed [31:0] wa = sa ? -$signed({1'b0, ma}) : $signed({1'b0, ma});
  wire signed [31:0] wb = sb ? -$signed({1'b0, mb}) : $signed({1'b0, mb});
  assign y = wa * wb;
endmodule
EOF
proc
opt -full
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul
select -assert-count 1 t:$mul r:A_WIDTH=5 r:B_WIDTH=5 %i %i
design -reset
log -pop

# Test A2: unsigned add over operands that were already sign-extended.
#
# Shape:
#   $neg  : na = -ma                        (4 -> 32 bits)
#   $mux  : wa = sa ? na : {28'b0, ma}      (32 bits)
#   $add  : y  = wa + wb, all ports unsigned, A_WIDTH = B_WIDTH = Y_WIDTH = 32
#
# This is how an elaborator emits signed addition: the operands are extended to
# the operation width first and the cell itself is unsigned. Read as unsigned the
# extension is load-bearing, so the pass must reinterpret both operands as signed
# -- which is only sound because nothing is extended (all widths are 32), making
# the two's-complement sum bit-identical either way.
log -header "A2: unsigned add over pre-extended operands"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire [31:0] y
);
  wire [31:0] na, nb, wa, wb;
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_a (.A(ma), .Y(na));
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_b (.A(mb), .Y(nb));
  $mux #(.WIDTH(32)) m_a (.A({28'b0, ma}), .B(na), .S(sa), .Y(wa));
  $mux #(.WIDTH(32)) m_b (.A({28'b0, mb}), .B(nb), .S(sb), .Y(wb));
  $add #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    add_ab (.A(wa), .B(wb), .Y(y));
endmodule
EOF
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$add r:A_WIDTH=5 r:B_WIDTH=5 %i %i
select -assert-count 1 t:$add r:A_SIGNED=1 r:B_SIGNED=1 %i %i
design -reset
log -pop

# Test A3: signed compare lowered as an unsigned compare with swapped sign bits.
#
# Shape:
#   $lt : y = {wb[31], wa[30:0]} < {wa[31], wb[30:0]}, both ports unsigned
#
# unsigned_lt({Ymsb, Xlow}, {Xmsb, Ylow}) is exactly signed_lt(X, Y): equal sign
# bits leave an unsigned compare of the low bits, unequal ones decide it. The
# pass must undo the swap to recover wa and wb, then narrow them to five bits as
# a signed compare. equiv_opt proves the identity rather than trusting it.
log -header "A3: compare with swapped sign bits"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire       y
);
  wire [31:0] na, nb, wa, wb;
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_a (.A(ma), .Y(na));
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_b (.A(mb), .Y(nb));
  $mux #(.WIDTH(32)) m_a (.A({28'b0, ma}), .B(na), .S(sa), .Y(wa));
  $mux #(.WIDTH(32)) m_b (.A({28'b0, mb}), .B(nb), .S(sb), .Y(wb));
  $lt #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(1))
    cmp (.A({wb[31], wa[30:0]}), .B({wa[31], wb[30:0]}), .Y(y));
endmodule
EOF
check -assert
design -save preopt
equiv_opt -assert opt_signif -types $lt
design -load preopt
opt_signif -types $lt
select -assert-count 1 t:$lt r:A_WIDTH=5 r:B_WIDTH=5 %i %i
select -assert-count 1 t:$lt r:A_SIGNED=1 r:B_SIGNED=1 %i %i
design -reset
log -pop

# Test A4: union over the arms of a $pmux.
#
# Shape:
#   wa = case (sel) 0: -7, 1: 5, 2: -m, default: m     (32 bits)
#   y  = wa * wb
#
# No single arm is wider than five signed bits, so the union is too and the
# multiply narrows. This exercises the arm-union rule rather than the mux rule.
log -header "A4: pmux arm union"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire [1:0] sel,
  input  wire       sb,
  output wire signed [31:0] y
);
  reg signed [31:0] wa;
  always @* begin
    case (sel)
      2'd0:    wa = -$signed(5'd7);
      2'd1:    wa = $signed(5'd5);
      2'd2:    wa = -$signed({1'b0, ma});
      default: wa = $signed({1'b0, ma});
    endcase
  end
  wire signed [31:0] wb = sb ? -$signed({1'b0, mb}) : $signed({1'b0, mb});
  assign y = wa * wb;
endmodule
EOF
proc
opt -full
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=5 r:B_WIDTH=5 %i %i
design -reset
log -pop

# Test A5: left shift by a bounded amount.
#
# Shape:
#   $shl : sh = m << e     (4-bit value, 2-bit shift amount -> [0, 120])
#   $mul : y  = sh * sh
#
# Scaling the operand range by the largest possible shift bounds the result at
# seven unsigned bits, so the multiply narrows from 32x32 to 7x7.
log -header "A5: bounded left shift"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0] m,
  input  wire [1:0] e,
  output wire [31:0] y
);
  wire [31:0] sh;
  $shl #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(4), .B_WIDTH(2), .Y_WIDTH(32))
    shifter (.A(m), .B(e), .Y(sh));
  $mul #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mult (.A(sh), .B(sh), .Y(y));
endmodule
EOF
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=7 r:B_WIDTH=7 %i %i
design -reset
log -pop

# Test A6: narrowing must stop at the width the value really needs.
#
# Shape:
#   wa = sa ? -$signed({1'b0, a16}) : $signed({1'b0, a16})    (32 bits, a16 is 16)
#   y  = wa * wa
#
# A 16-bit magnitude genuinely needs 17 signed bits. Landing anywhere below 17
# would be an unsound under-approximation, so this pins the exact width rather
# than merely asserting that something got smaller.
log -header "A6: exact significant width, not merely smaller"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [15:0] a16,
  input  wire        sa,
  output wire signed [31:0] y
);
  wire signed [31:0] wa = sa ? -$signed({1'b0, a16}) : $signed({1'b0, a16});
  assign y = wa * wa;
endmodule
EOF
proc
opt -full
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=17 r:B_WIDTH=17 %i %i
design -reset
log -pop

# Test A7: range propagates through a chain of modular cells.
#
# Shape:
#   $add : sum  = wa + wb        (unsigned, all widths 32)
#   $neg : nsum = -sum           (unsigned input, 32 -> 32)
#   $mul : y    = nsum * wa      (signed, 32x32)
#
# The multiply is two modular hops away from the only narrow values in the
# design. Both hops declare unsigned operands, so without reading them as signed
# the range dies at the first cell and the multiply keeps 32x32.
log -header "A7: propagation through a modular chain"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire [31:0] y
);
  wire [31:0] na, nb, wa, wb, sum, nsum;
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_a (.A(ma), .Y(na));
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_b (.A(mb), .Y(nb));
  $mux #(.WIDTH(32)) m_a (.A({28'b0, ma}), .B(na), .S(sa), .Y(wa));
  $mux #(.WIDTH(32)) m_b (.A({28'b0, mb}), .B(nb), .S(sb), .Y(wb));
  $add #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    add_ab (.A(wa), .B(wb), .Y(sum));
  $neg #(.A_SIGNED(0), .A_WIDTH(32), .Y_WIDTH(32)) n_s (.A(sum), .Y(nsum));
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mult (.A(nsum), .B(wa), .Y(y));
endmodule
EOF
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=6 r:B_WIDTH=5 %i %i
design -reset
log -pop

# Test A8: a compare whose two sides need different widths.
#
# Shape:
#   wa = sa ? -$signed({1'b0, a4})  : $signed({1'b0, a4})    (needs 5 bits)
#   wb = sb ? -$signed({1'b0, b16}) : $signed({1'b0, b16})   (needs 17 bits)
#   y  = wa < wb
#
# Narrowing each side to its own requirement would leave a 5-bit vs 17-bit
# compare. That is legal RTLIL but not what the rest of the flow expects: wreduce
# trims a compare's operands together, and opt_maxcmp compares one operand's
# lanes against the other operand directly and asserts on a width mismatch. So
# both sides must land on the wider requirement, 17, and stay equal.
log -header "A8: compare operands stay equal width"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0]  a4,
  input  wire [15:0] b16,
  input  wire        sa,
  input  wire        sb,
  output wire        y
);
  wire signed [31:0] wa = sa ? -$signed({1'b0, a4})  : $signed({1'b0, a4});
  wire signed [31:0] wb = sb ? -$signed({1'b0, b16}) : $signed({1'b0, b16});
  assign y = wa < wb;
endmodule
EOF
proc
opt -full
check -assert
design -save preopt
equiv_opt -assert opt_signif -types $lt
design -load preopt
opt_signif -types $lt
select -assert-count 1 t:$lt r:A_WIDTH=17 r:B_WIDTH=17 %i %i
design -reset
log -pop

# Test A9: subtraction, where the two operand rules differ in sign.
#
# Shape:
#   $sub : y = wa - wb, both ports signed and 32 bits wide
#
# $sub's range rule is [la - hb, ha - lb], so it is the one rule where the B
# operand's bounds enter with their signs exchanged. Getting that backwards still
# produces a plausible-looking narrow width, which equiv_opt would then reject.
log -header "A9: subtract range rule"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire signed [31:0] y
);
  wire signed [31:0] wa = sa ? -$signed({1'b0, ma}) : $signed({1'b0, ma});
  wire signed [31:0] wb = sb ? -$signed({1'b0, mb}) : $signed({1'b0, mb});
  assign y = wa - wb;
endmodule
EOF
proc
opt -full
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$sub r:A_WIDTH=5 r:B_WIDTH=5 %i %i
design -reset
log -pop

# Test A10: a mask bounds an otherwise unbounded operand.
#
# Shape:
#   $and : masked = u & 32'h0000000f      (u is a 32-bit unsigned input)
#   $mul : y      = masked * {28'b0, c}
#
# u itself has no useful range, so the narrowing can only come from the $and
# rule [0, min(ha, hb)]. Written with -icells and no opt because opt_expr would
# otherwise const-fold the masked-off bits and make the operand narrow for a
# different reason than the one under test.
log -header "A10: mask bounds an unbounded operand"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [31:0] u,
  input  wire [3:0]  c,
  output wire [31:0] y
);
  wire [31:0] masked;
  $and #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mask (.A(u), .B(32'h0000000f), .Y(masked));
  $mul #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mult (.A(masked), .B({28'b0, c}), .Y(y));
endmodule
EOF
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=4 r:B_WIDTH=4 %i %i
design -reset
log -pop

# Test A11: an unsigned right shift cannot grow its operand.
#
# Shape:
#   $shr : s = {24'b0, byte} >> shamt     (shamt is a 3-bit input)
#   $mul : y = s * {28'b0, c}
#
# Shifting right moves toward zero, so [0, ha] still bounds the result whatever
# the distance is. Eight bits is the width only that rule yields: without it the
# operand falls back to its declared 32.
log -header "A11: unsigned right shift keeps the operand bound"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [7:0]  byte_i,
  input  wire [2:0]  shamt,
  input  wire [3:0]  c,
  output wire [31:0] y
);
  wire [31:0] s;
  $shr #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(3), .Y_WIDTH(32))
    sh (.A({24'b0, byte_i}), .B(shamt), .Y(s));
  $mul #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mult (.A(s), .B({28'b0, c}), .Y(y));
endmodule
EOF
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=8 r:B_WIDTH=4 %i %i
design -reset
log -pop

# Test A12: an arithmetic right shift of a signed value stays in range.
#
# Shape:
#   wa = sa ? -$signed({1'b0, ma}) : $signed({1'b0, ma})   ([-15, 15])
#   $sshr : ws = wa >>> shamt
#   $mul  : y  = ws * wb
#
# An arithmetic shift right rounds toward negative infinity but never leaves
# [min(lo, 0), max(hi, 0)], so the five significant bits survive the shift.
log -header "A12: arithmetic right shift keeps the operand bound"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  input  wire [2:0] shamt,
  output wire signed [31:0] y
);
  wire signed [31:0] wa = sa ? -$signed({1'b0, ma}) : $signed({1'b0, ma});
  wire signed [31:0] wb = sb ? -$signed({1'b0, mb}) : $signed({1'b0, mb});
  assign y = (wa >>> shamt) * wb;
endmodule
EOF
proc
opt -full
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=5 r:B_WIDTH=5 %i %i
design -reset
log -pop

# Test A13: narrowing is per port, not per cell.
#
# Shape:
#   $mul : y = wa * b, wa sign-muxed over 4-bit magnitudes, b a 32-bit signed input
#
# The two ports are independent parameters, so the narrow one must shrink while
# the genuinely wide one keeps all 32 bits. A pass that decided per cell would
# either miss the win or corrupt the wide operand.
log -header "A13: only the narrow port of a mixed multiply shrinks"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0] ma,
  input  wire       sa,
  input  wire signed [31:0] b,
  output wire signed [31:0] y
);
  wire signed [31:0] wa = sa ? -$signed({1'b0, ma}) : $signed({1'b0, ma});
  assign y = wa * b;
endmodule
EOF
proc
opt -full
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=5 r:B_WIDTH=32 %i %i
design -reset
log -pop

# Test A14: negate at the declared width over a narrow value.
#
# Shape:
#   $mux : v = sel ? {28'b0, ma} : {28'b0, mb}   (32 bits)
#   $neg : y = -v                                (A_WIDTH = Y_WIDTH = 32)
#
# A sign mux over a magnitude lowers to exactly this, so datapath code pays the
# full declared width once per lane even when the products feeding it are written
# narrowly. The mux is what keeps wreduce out: its output bits are distinct nets
# rather than one repeated sign bit. v only holds [0, 15], so five signed bits
# suffice on the operand -- the result stays 32 bits wide.
log -header "A14: negate over a mux-hidden narrow value"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sel,
  output wire signed [31:0] y
);
  wire signed [31:0] v = sel ? $signed({1'b0, ma}) : $signed({1'b0, mb});
  assign y = -v;
endmodule
EOF
proc
opt -full
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$neg r:A_WIDTH=5 r:Y_WIDTH=32 %i %i
design -reset
log -pop

# ============================================================================
# Group B: Rejected shapes
# ============================================================================

# Test B1: a genuine full-width signed multiply.
#
# Shape:
#   $mul : y = a * b, both 32-bit signed module inputs
#
# No sign-copy prefix exists, so the pass must leave both operands at 32 bits.
# This is the case the sign-muxed shapes must remain distinguishable from.
log -header "B1: reject a genuine full-width multiply"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire signed [31:0] a,
  input  wire signed [31:0] b,
  output wire signed [31:0] y
);
  assign y = a * b;
endmodule
EOF
proc
opt -full
check -assert
equiv_opt -assert opt_signif
design -load postopt
select -assert-count 1 t:$mul r:A_WIDTH=32 r:B_WIDTH=32 %i %i
design -reset
log -pop

# Test B2: an accumulator that genuinely grows.
#
# Shape:
#   acc <= acc + d      (32-bit acc, 4-bit d)
#   y    = acc * c
#
# acc reaches the full datapath over time, and its range depends on itself. The
# analysis breaks the loop by falling back to the declared width, so acc must
# stay 32 bits on both cells; narrowing it would be a functional bug. Only the
# genuinely narrow addend and coefficient may shrink.
log -header "B2: reject a self-accumulating register"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire [3:0] d,
  input  wire [3:0] c,
  output wire signed [31:0] y
);
  reg signed [31:0] acc;
  always @(posedge clk) acc <= acc + $signed({1'b0, d});
  assign y = acc * $signed({1'b0, c});
endmodule
EOF
proc
opt -full
check -assert
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=32 %i
design -reset
log -pop

# Test B3: an unsigned operand whose high bits carry data.
#
# Shape:
#   $mul : y = u * c, u is a 32-bit unsigned input, c is 4 bits
#
# u's upper bits are not zero extension, so only c may narrow.
log -header "B3: reject an unsigned operand with live high bits"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [31:0] u,
  input  wire [3:0]  c,
  output wire [31:0] y
);
  $mul #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mult (.A(u), .B({28'b0, c}), .Y(y));
endmodule
EOF
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=32 %i
design -reset
log -pop

# Test B4: unsigned add whose result is wider than its operands.
#
# Shape:
#   $add : y[32:0] = wa + wb, both ports unsigned and 32 bits wide
#
# Here the operands really are zero-extended, from 32 to the 33-bit operation
# width, and that zero extension is part of the result. Reinterpreting them as
# signed would sign-extend instead and change bit 32, so the flip must be
# refused even though both operands hold only five significant bits. This is the
# guard that makes A2 sound; equiv_opt fails loudly if it is ever dropped.
log -header "B4: reject the flip when operands are really zero-extended"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire [32:0] y
);
  wire [31:0] na, nb, wa, wb;
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_a (.A(ma), .Y(na));
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_b (.A(mb), .Y(nb));
  $mux #(.WIDTH(32)) m_a (.A({28'b0, ma}), .B(na), .S(sa), .Y(wa));
  $mux #(.WIDTH(32)) m_b (.A({28'b0, mb}), .B(nb), .S(sb), .Y(wb));
  $add #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(33))
    add_ab (.A(wa), .B(wb), .Y(y));
endmodule
EOF
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$add r:A_WIDTH=32 r:B_WIDTH=32 %i %i
select -assert-count 1 t:$add r:A_SIGNED=0 %i
design -reset
log -pop

# Test B5: undefined bits above the significant part.
#
# Shape:
#   $mul : y = {28'bx, m} * c
#
# Undefined bits are not a value, so the analysis must refuse to read a range
# through them instead of treating them as zero. The B operand is genuinely
# zero-extended and does narrow, which keeps the assertion about A meaningful.
log -header "B5: reject undefined high bits"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0]  m,
  input  wire [3:0]  c,
  output wire [31:0] y
);
  $mul #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mult (.A({28'bx, m}), .B({28'b0, c}), .Y(y));
endmodule
EOF
check -assert
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=32 %i
design -reset
log -pop

# Test B6: a genuinely unsigned compare.
#
# Shape:
#   $lt : y = a8 < b8, both unsigned 8-bit inputs, no sign-bit swap
#
# The compare-swap rewrite reconstructs its operands by exchanging the top bits
# back. On a real unsigned compare that produces a mixed word no cell drives, so
# its range degrades to the declared width and nothing narrows. Without that
# self-rejection the rewrite would change the comparison's meaning.
log -header "B6: reject a genuinely unsigned compare"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [7:0] a8,
  input  wire [7:0] b8,
  output wire       y
);
  $lt #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(1))
    cmp (.A(a8), .B(b8), .Y(y));
endmodule
EOF
check -assert
opt_signif -types $lt
select -assert-count 1 t:$lt r:A_WIDTH=8 r:B_WIDTH=8 %i %i
select -assert-count 1 t:$lt r:A_SIGNED=0 %i
design -reset
log -pop

# Test B7: a shift whose product no longer fits its output word.
#
# Shape:
#   $shl : s = {28'b0, m} << shamt        (shamt is a 5-bit input, so up to 31)
#   $mul : y = s * {28'b0, c}
#
# 15 << 31 needs 36 bits, so the 32-bit output word wraps and the computed range
# no longer describes it. The analysis must discard the range instead of clamping
# it, which would claim a narrow result the hardware does not produce.
log -header "B7: reject a shift that wraps its output word"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0]  m,
  input  wire [4:0]  shamt,
  input  wire [3:0]  c,
  output wire [31:0] y
);
  wire [31:0] s;
  $shl #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(5), .Y_WIDTH(32))
    sh (.A({28'b0, m}), .B(shamt), .Y(s));
  $mul #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mult (.A(s), .B({28'b0, c}), .Y(y));
endmodule
EOF
check -assert
design -save preopt
equiv_opt -assert opt_signif
design -load preopt
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=32 %i
design -reset
log -pop

# Test B8: one wide arm poisons the whole mux.
#
# Shape:
#   wa = s ? wide : $signed({1'b0, ma})   (wide is a 32-bit signed input)
#   $mul : y = wa * wb
#
# The mux rule is a union over the arms, so a single unbounded arm makes the
# result unbounded. Taking the narrow arm's range would be a functional bug.
log -header "B8: reject a mux with one wide arm"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       s,
  input  wire       sb,
  input  wire signed [31:0] wide,
  output wire signed [31:0] y
);
  wire signed [31:0] wa = s ? wide : $signed({1'b0, ma});
  wire signed [31:0] wb = sb ? -$signed({1'b0, mb}) : $signed({1'b0, mb});
  assign y = wa * wb;
endmodule
EOF
proc
opt -full
check -assert
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=32 %i
design -reset
log -pop

# Test B9: an endpoint at the edge of the interval arithmetic.
#
# Shape:
#   $mul : p = a64 * {1'b0, u64}, into a 128-bit word
#   $neg : n = -p
#   $mul : y = n * c
#
# p's low corner is -2^63 * (2^64 - 1), which is representable in 128 bits and so
# passes the multiply's overflow check, yet needs 128 signed bits. The output-width
# cap alone would let it through on a 128-bit word, and negating it in the next cell
# has no representable result. The max_range_width cap discards it first, which is
# what keeps the negation in the $neg and $sub rules defined without a check on
# every endpoint. Nothing is narrowable either way here, so the assertion pins the
# shape rather than the cap: it fails if a future rule narrows through this corner.
log -header "B9: reject a range at the interval-arithmetic boundary"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire signed [63:0]  a64,
  input  wire [63:0]         u64,
  input  wire [3:0]          c,
  output wire [127:0]        y
);
  wire [127:0] p, n;
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(64), .B_WIDTH(65), .Y_WIDTH(128))
    prod (.A(a64), .B({1'b0, u64}), .Y(p));
  $neg #(.A_SIGNED(1), .A_WIDTH(128), .Y_WIDTH(128)) negp (.A(p), .Y(n));
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(128), .B_WIDTH(128), .Y_WIDTH(128))
    mult (.A(n), .B({124'b0, c}), .Y(y));
endmodule
EOF
check -assert
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=128 %i
design -reset
log -pop

# ============================================================================
# Group C: Options and idempotence
# ============================================================================

# Test C1: -types restricts which operators are narrowed.
#
# The design offers both a narrowable $mul and a narrowable $add. Asking for
# $mul only must leave the add at full width, so the flag can scope the rewrite
# to the operator classes a flow has measured.
log -header "C1: -types scopes the rewrite"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire [31:0] y0,
  output wire [31:0] y1
);
  wire [31:0] na, nb, wa, wb;
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_a (.A(ma), .Y(na));
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_b (.A(mb), .Y(nb));
  $mux #(.WIDTH(32)) m_a (.A({28'b0, ma}), .B(na), .S(sa), .Y(wa));
  $mux #(.WIDTH(32)) m_b (.A({28'b0, mb}), .B(nb), .S(sb), .Y(wb));
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mult (.A(wa), .B(wb), .Y(y0));
  $add #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    add_ab (.A(wa), .B(wb), .Y(y1));
endmodule
EOF
check -assert
opt_signif -types $mul
select -assert-count 1 t:$mul r:A_WIDTH=5 %i
select -assert-count 1 t:$add r:A_WIDTH=32 %i
design -reset
log -pop

# Test C2: a second run finds nothing left to do.
#
# Once each operand sits at its significant width the pass must be a no-op, so
# repeated invocations in a flow neither churn the netlist nor loop forever.
log -header "C2: idempotent on an already narrowed design"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire signed [31:0] y
);
  wire signed [31:0] wa = sa ? -$signed({1'b0, ma}) : $signed({1'b0, ma});
  wire signed [31:0] wb = sb ? -$signed({1'b0, mb}) : $signed({1'b0, mb});
  assign y = wa * wb;
endmodule
EOF
proc
opt -full
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=5 %i
design -save once
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=5 r:B_WIDTH=5 %i %i
design -reset
log -pop

# Test C3: exhausting the evaluation budget degrades safely.
#
# With no budget at all, every range lookup must fall back to the declared width,
# so the A7 chain narrows nothing and the design is left exactly as it was. This
# pins the direction of the failure mode: running out of budget has to lose
# opportunities, never emit a range it could not justify.
log -header "C3: budget exhaustion falls back to declared widths"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire [31:0] y
);
  wire [31:0] na, nb, wa, wb, sum, nsum;
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_a (.A(ma), .Y(na));
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_b (.A(mb), .Y(nb));
  $mux #(.WIDTH(32)) m_a (.A({28'b0, ma}), .B(na), .S(sa), .Y(wa));
  $mux #(.WIDTH(32)) m_b (.A({28'b0, mb}), .B(nb), .S(sb), .Y(wb));
  $add #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    add_ab (.A(wa), .B(wb), .Y(sum));
  $neg #(.A_SIGNED(0), .A_WIDTH(32), .Y_WIDTH(32)) n_s (.A(sum), .Y(nsum));
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(32))
    mult (.A(nsum), .B(wa), .Y(y));
endmodule
EOF
check -assert
opt_signif -max_steps 0
select -assert-count 1 t:$mul r:A_WIDTH=32 r:B_WIDTH=32 %i %i
select -assert-count 1 t:$add r:A_WIDTH=32 r:B_WIDTH=32 %i %i
design -reset
log -pop

# Test C5: compares are not narrowed unless asked for.
#
# Same design as A3, which narrows to 5x5 under -types $lt. The default set must
# leave it at 32x32: a compare's width is read by the matchers that run later, so
# narrowing one is only worth it for a flow that has measured the trade.
log -header "C5: compares are off by default"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire       y
);
  wire [31:0] na, nb, wa, wb;
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_a (.A(ma), .Y(na));
  $neg #(.A_SIGNED(0), .A_WIDTH(4), .Y_WIDTH(32)) n_b (.A(mb), .Y(nb));
  $mux #(.WIDTH(32)) m_a (.A({28'b0, ma}), .B(na), .S(sa), .Y(wa));
  $mux #(.WIDTH(32)) m_b (.A({28'b0, mb}), .B(nb), .S(sb), .Y(wb));
  $lt #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(32), .B_WIDTH(32), .Y_WIDTH(1))
    cmp (.A({wb[31], wa[30:0]}), .B({wa[31], wb[30:0]}), .Y(y));
endmodule
EOF
check -assert
opt_signif
select -assert-count 1 t:$lt r:A_WIDTH=32 r:B_WIDTH=32 %i %i
design -reset
log -pop

# Test C4: a chain far deeper than the recursion guard.
#
# Range lookup walks the driver graph recursively, so a long chain of dependent
# adds recurses once per link. 1500 links is past the default -max_depth of 1000,
# so this is the shape that would overflow the native stack without a depth guard.
#
# It also checks precision on a chain: acc[i] is at most 15*(i+1), so it stops
# fitting in 11 bits at i = 135, and the pass narrows exactly the 136 adds up to
# that point and no more.
log -header "C4: deep driver chain stays within the recursion guard"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0]  d,
  output wire [11:0] y
);
  wire [11:0] acc [0:1500];
  assign acc[0] = {8'b0, d};
  genvar i;
  generate
    for (i = 0; i < 1500; i = i + 1) begin : chain
      assign acc[i+1] = acc[i] + d;
    end
  endgenerate
  assign y = acc[1500];
endmodule
EOF
proc
check -assert
select -assert-count 1500 t:$add
opt_signif
check -assert
select -assert-count 1500 t:$add
select -assert-count 1364 t:$add r:A_WIDTH=12 %i
design -reset
log -pop

# Test C6: -min-bits declines narrowings smaller than it asks for.
#
# The later pattern matchers read a cell's output as a whole word, so a rewrite that
# trims a bit or two off one reader can cost a compressor level or a peephole that was
# worth far more than the bits. A flow that runs such matchers after this pass needs to
# be able to price the rewrite. Here each of the mul's two ports drops 32 bits to 5, so
# 54 is exactly affordable and 55 is not.
log -header "C6: -min-bits prices the rewrite in operand bits"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire [3:0] ma,
  input  wire [3:0] mb,
  input  wire       sa,
  input  wire       sb,
  output wire signed [31:0] y
);
  wire signed [31:0] wa = sa ? -$signed({1'b0, ma}) : $signed({1'b0, ma});
  wire signed [31:0] wb = sb ? -$signed({1'b0, mb}) : $signed({1'b0, mb});
  assign y = wa * wb;
endmodule
EOF
proc
opt -full
design -save wide

# Exactly affordable: both operand ports still come down
opt_signif -types $mul -min-bits 54
select -assert-count 1 t:$mul r:A_WIDTH=5 r:B_WIDTH=5 %i %i

# One bit dearer than the rewrite is worth: left alone
design -load wide
opt_signif -types $mul -min-bits 55
select -assert-count 1 t:$mul r:A_WIDTH=32 r:B_WIDTH=32 %i %i

# The default takes it, so raising the bar is the only thing that declines it
design -load wide
opt_signif -types $mul
select -assert-count 1 t:$mul r:A_WIDTH=5 %i
design -reset
log -pop

# ============================================================================
# Group D: Carrying ranges across registers (-cross-flops)
# ============================================================================
#
# A pipelined datapath registers every lane term before the accumulate tree, so
# without -cross-flops the analysis stops at Q and every adder in the tree is
# priced at the declared accumulator width. With it, Q is bounded by the union of
# everything the register can hold: its data input, an async load, a reset value,
# and a defined init.
#
# An all-undefined init is read as the absence of one rather than as "any value",
# which is what makes the flag an assumption rather than a theorem: it is sound
# for every state reachable after reset, and D1 proves both halves of that with
# the solver -- equivalent from a zero initial state, distinguishable from an
# arbitrary one.

# Test D1: two registered products feeding an adder.
#
# Shape:
#   t0 <= a0 * b0;  t1 <= a1 * b1     (4x4 signed, held in 32-bit registers)
#   y = t0 + t1
#
# Each product lands in [-56, 64], so eight signed bits carry it and the adder
# should be 8+8 rather than 32+32. Off by default, so the first run pins that the
# flag is opt-in.
log -header "D1: registered products feeding an adder"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire signed [3:0] a0,
  input  wire signed [3:0] b0,
  input  wire signed [3:0] a1,
  input  wire signed [3:0] b1,
  output wire signed [31:0] y
);
  reg signed [31:0] t0, t1;
  always @(posedge clk) begin
    t0 <= a0 * b0;
    t1 <= a1 * b1;
  end
  assign y = t0 + t1;
endmodule
EOF
proc
opt -full
check -assert
design -save preopt
opt_signif
select -assert-count 1 t:$add r:A_WIDTH=32 r:B_WIDTH=32 %i %i
design -load preopt
opt_signif -cross-flops
select -assert-count 1 t:$add r:A_WIDTH=8 r:B_WIDTH=8 %i %i

# Equivalent from reset. equiv_opt cannot show this: its induction step assumes
# only that the two register words agree, and a 32-bit value they could agree on
# is outside the range the data input can produce, so it has to report a
# difference. Bounded model checking from a zero initial state asks the question
# the rule actually answers.
design -load preopt
design -save gold
opt_signif -cross-flops
design -stash gate
design -copy-from gold -as gold top
design -copy-from gate -as gate top
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -seq 8 -set-init-zero -prove-asserts miter

# ... and not from an arbitrary power-up state. -falsify inverts the expectation,
# so this passes by finding the counterexample, which pins the assumption as a
# real one rather than an unproven claim.
design -reset
design -copy-from gold -as gold top
design -copy-from gate -as gate top
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -falsify -seq 1 -set-init-def -enable_undef -prove-asserts miter
design -reset
log -pop

# Test D2: the same shape after the registers are blasted to one-bit cells.
#
# This is how a pipeline register reaches the pass in a flow that splits flops for
# per-bit reporting: no cell drives the whole word, so the range has to come from
# reassembling the word the data inputs form.
log -header "D2: blasted registers are reassembled"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire signed [3:0] a0,
  input  wire signed [3:0] b0,
  input  wire signed [3:0] a1,
  input  wire signed [3:0] b1,
  output wire signed [31:0] y
);
  reg signed [31:0] t0, t1;
  always @(posedge clk) begin
    t0 <= a0 * b0;
    t1 <= a1 * b1;
  end
  assign y = t0 + t1;
endmodule
EOF
proc
opt -full
splitcells -blast t:$dff
check -assert
select -assert-count 64 t:$dff
opt_signif -cross-flops
select -assert-count 1 t:$add r:A_WIDTH=8 r:B_WIDTH=8 %i %i
design -reset
log -pop

# Test D3: the range crosses two register stages.
#
# td holds what t held, which holds a product: the analysis has to recurse through
# both flops rather than stopping at the first.
log -header "D3: range crosses two register stages"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [31:0] y
);
  reg signed [31:0] t, td;
  always @(posedge clk) begin
    t  <= a * b;
    td <= t;
  end
  assign y = td * c;
endmodule
EOF
proc
opt -full
check -assert
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=8 %i
design -reset
log -pop

# Test D4: a word split across two registers, capturing together and apart.
#
# Shape (icells, so the split survives to the pass):
#   lo: t[7:0]  <= p[7:0]
#   hi: t[31:8] <= p[31:8]      p = a * b, so t holds a value in [-56, 64]
#   y = t * c
#
# Reassembling {hi.D, lo.D} recovers p and narrows the multiply to 8 bits. Moving
# hi to a second clock must stop that: bits that capture at different times can
# pair a stale sign with a fresh low word, which no single value of p allows.
log -header "D4: a word split across registers needs one capture event"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire clkA,
  input  wire clkB,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [31:0] y
);
  wire signed [31:0] p;
  wire [31:0] t;
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(4), .B_WIDTH(4), .Y_WIDTH(32))
    prod (.A(a), .B(b), .Y(p));
  $dff #(.WIDTH(8),  .CLK_POLARITY(1)) lo (.CLK(clkA), .D(p[7:0]),  .Q(t[7:0]));
  $dff #(.WIDTH(24), .CLK_POLARITY(1)) hi (.CLK(clkA), .D(p[31:8]), .Q(t[31:8]));
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(32), .B_WIDTH(4), .Y_WIDTH(32))
    mult (.A(t), .B(c), .Y(y));
endmodule
EOF
check -assert
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=8 %i

design -reset
read_verilog -icells <<EOF
module top(
  input  wire clkA,
  input  wire clkB,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [31:0] y
);
  wire signed [31:0] p;
  wire [31:0] t;
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(4), .B_WIDTH(4), .Y_WIDTH(32))
    prod (.A(a), .B(b), .Y(p));
  $dff #(.WIDTH(8),  .CLK_POLARITY(1)) lo (.CLK(clkA), .D(p[7:0]),  .Q(t[7:0]));
  $dff #(.WIDTH(24), .CLK_POLARITY(1)) hi (.CLK(clkB), .D(p[31:8]), .Q(t[31:8]));
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(32), .B_WIDTH(4), .Y_WIDTH(32))
    mult (.A(t), .B(c), .Y(y));
endmodule
EOF
check -assert
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=32 %i
design -reset
log -pop

# Test D5: an accumulator behind registered terms.
#
#   t0 <= a0 * b0;  t1 <= a1 * b1;  acc <= acc + (t0 + t1)
#
# The tree add narrows to 8+8 and the sum it produces bounds the accumulator's B
# port at 9 bits, but acc itself reaches the full datapath over time, so the
# feedback operand has to stay 32. This is B2 with the flag on: crossing flops
# must not turn a growing register into a narrow one.
log -header "D5: an accumulator behind registered terms stays wide"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire signed [3:0] a0,
  input  wire signed [3:0] b0,
  input  wire signed [3:0] a1,
  input  wire signed [3:0] b1,
  output wire signed [31:0] y
);
  reg signed [31:0] t0, t1, acc;
  always @(posedge clk) begin
    t0  <= a0 * b0;
    t1  <= a1 * b1;
    acc <= acc + (t0 + t1);
  end
  assign y = acc;
endmodule
EOF
proc
opt -full
check -assert
opt_signif -cross-flops
select -assert-count 1 t:$add r:A_WIDTH=8 r:B_WIDTH=8 %i %i
select -assert-count 1 t:$add r:A_WIDTH=32 r:B_WIDTH=9 %i %i
design -reset
log -pop

# Test D6: a reset value the data input cannot produce.
#
# The register holds a product in [-56, 64] or, on reset, 2^30. The union needs
# the whole word, so nothing narrows -- a reset value is a value the register can
# hold, not a special case to skip. The second design is the same shape with a
# small reset constant, which keeps the first from passing for a reason unrelated
# to the reset value.
log -header "D6: a reset value widens the union"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire rst,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [31:0] y
);
  reg signed [31:0] t;
  always @(posedge clk) if (rst) t <= 32'sh4000_0000; else t <= a * b;
  assign y = t * c;
endmodule
EOF
proc
opt -full
check -assert
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=32 %i

design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire rst,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [31:0] y
);
  reg signed [31:0] t;
  always @(posedge clk) if (rst) t <= 32'sd1; else t <= a * b;
  assign y = t * c;
endmodule
EOF
proc
opt -full
check -assert
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=8 %i
design -reset
log -pop

# Test D7: a blasted register wider than the interval arithmetic.
#
# A 128-bit accumulator holding an 8-bit value is the case most worth handling and
# the one a width test on the register would refuse: the endpoints fit in the
# 128-bit intervals even though the word does not. What has to stay capped is the
# range carried out, so that the next $neg or $sub can still negate its endpoints
# -- the same rule cell_range applies to a cell output.
log -header "D7: a blasted register past the interval arithmetic"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  reg signed [127:0] t;
  always @(posedge clk) t <= a * b;
  assign y = t * c;
endmodule
EOF
proc
opt -full
splitcells -blast t:$dff
check -assert
select -assert-count 128 t:$dff
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=8 %i
design -reset
log -pop

# Test D8: a blasted unsigned register whose reset has its MSB set.
#
# Shape (icells, then blasted, so no cell drives the whole word):
#   t[7:0] <= a[3:0]      unsigned $sdff, SRST_VALUE = 8'h80
#   s = t + t             unsigned, 8+8 -> 16 (non-modular)
#   y = s * c             signed
#
# The forced value is 128, not -128. Reading it as signed under-approximates t
# as [-128, 15], so s lands in [-256, 30] and the multiply narrows to 9 bits --
# which cannot hold the reset sum 256. Ten signed bits can. The same shape with
# a small reset still narrows, so a failure of the first design is not just
# "the pass refused to look at a blasted unsigned register".
log -header "D8: unsigned MSB-set reset is not a signed value"
log -push
design -reset
read_verilog -icells <<EOF
module top(
  input  wire clk,
  input  wire rst,
  input  wire [3:0] a,
  input  wire signed [15:0] c,
  output wire signed [15:0] y
);
  wire [7:0] d = {4'b0000, a};
  wire [7:0] t;
  wire [15:0] s;
  $sdff #(.WIDTH(8), .CLK_POLARITY(1), .SRST_POLARITY(1), .SRST_VALUE(8'h80))
    ff (.CLK(clk), .SRST(rst), .D(d), .Q(t));
  $add #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(16))
    add (.A(t), .B(t), .Y(s));
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(16), .B_WIDTH(16), .Y_WIDTH(16))
    mul (.A(s), .B(c), .Y(y));
endmodule
EOF
check -assert
splitcells -blast t:$sdff
select -assert-count 8 t:$sdff
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=10 %i

design -reset
read_verilog -icells <<EOF
module top(
  input  wire clk,
  input  wire rst,
  input  wire [3:0] a,
  input  wire signed [15:0] c,
  output wire signed [15:0] y
);
  wire [7:0] d = {4'b0000, a};
  wire [7:0] t;
  wire [15:0] s;
  $sdff #(.WIDTH(8), .CLK_POLARITY(1), .SRST_POLARITY(1), .SRST_VALUE(8'h01))
    ff (.CLK(clk), .SRST(rst), .D(d), .Q(t));
  $add #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(16))
    add (.A(t), .B(t), .Y(s));
  $mul #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(16), .B_WIDTH(16), .Y_WIDTH(16))
    mul (.A(s), .B(c), .Y(y));
endmodule
EOF
check -assert
splitcells -blast t:$sdff
select -assert-count 8 t:$sdff
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=6 %i
design -reset
log -pop

# Test D9: constants wider than the interval arithmetic.
#
# A cleared pipeline register and a zeroed mux arm are both words of the datapath's
# own width, so in a wide datapath both are wider than the arithmetic can hold. Their
# value is still 0, and refusing them by width loses the register for the two shapes
# real RTL always has: a reset and a special-value mux. What still has to be refused
# is a constant whose value genuinely needs those bits, which the third design pins.
log -header "D9: a wide constant is read by value, not by width"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire rst,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  reg signed [127:0] t;
  always @(posedge clk or posedge rst)
    if (rst) t <= 128'b0;
    else t <= a * b;
  assign y = t * c;
endmodule
EOF
proc
opt -full
splitcells -blast t:$adff
check -assert
select -assert-count 128 t:$adff
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=8 %i

# The same register behind a special-value mux, the arm being a full-width zero
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire z,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  wire signed [127:0] p = a * b;
  wire signed [127:0] m = z ? 128'sb0 : p;
  reg signed [127:0] t;
  always @(posedge clk) t <= m;
  assign y = t * c;
endmodule
EOF
proc
opt -full
splitcells -blast t:$dff
check -assert
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=8 %i

# Negative control: a reset value that genuinely needs the whole word keeps it
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire rst,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  reg signed [127:0] t;
  always @(posedge clk or posedge rst)
    if (rst) t <= 128'sh4000_0000_0000_0000_0000_0000_0000_0000;
    else t <= a * b;
  assign y = t * c;
endmodule
EOF
proc
opt -full
splitcells -blast t:$adff
check -assert
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=128 %i
design -reset
log -pop

# Test E1: a lane written as its own module.
#
# This is how datapath RTL is actually written, and a per-module analysis gets nothing
# from it: the term arrives at the reader as a port of the declared datapath width. The
# module's own inputs bound what it can put there, so analyzing it once answers for every
# instance. The registered variant needs -cross-flops on top, since the term is a pipeline
# register in the shape a real lane has.
log -header "E1: an instance's output word is bounded by the module it instantiates"
log -push
design -reset
read_verilog <<EOF
module lane(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  output wire signed [127:0] y
);
  assign y = a * b;
endmodule

module top(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  wire signed [127:0] t;
  lane u (.a(a), .b(b), .y(t));
  assign y = t * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
check -assert
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=8 %i

# The same shape with the term registered, which is what a pipelined lane emits
design -reset
read_verilog <<EOF
module lane(
  input  wire clk,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  output wire signed [127:0] y
);
  reg signed [127:0] t;
  always @(posedge clk) t <= a * b;
  assign y = t;
endmodule

module top(
  input  wire clk,
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  wire signed [127:0] t;
  lane u (.clk(clk), .a(a), .b(b), .y(t));
  assign y = t * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
splitcells -blast t:$dff
check -assert
opt_signif -cross-flops
select -assert-count 1 t:$mul r:A_WIDTH=8 %i

# -no-cross-hier is the behavior before the boundary was crossed: the reader keeps the
# declared width no matter what the module can put on the port
design -reset
read_verilog <<EOF
module lane(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  output wire signed [127:0] y
);
  assign y = a * b;
endmodule

module top(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  wire signed [127:0] t;
  lane u (.a(a), .b(b), .y(t));
  assign y = t * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
check -assert
opt_signif -no-cross-hier
select -assert-count 1 t:$mul r:A_WIDTH=128 %i
design -reset
log -pop

# Test E2: boundaries nest, so the analysis has to as well. The product module bounds the
# lane's output, which bounds the top's operand; stopping at either level loses the rest.
log -header "E2: ranges compose through two levels of hierarchy"
log -push
design -reset
read_verilog <<EOF
module prod(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  output wire signed [63:0] p
);
  assign p = a * b;
endmodule

module lane(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  output wire signed [127:0] y
);
  wire signed [63:0] p;
  prod u (.a(a), .b(b), .p(p));
  assign y = p;
endmodule

module top(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  wire signed [127:0] t;
  lane u (.a(a), .b(b), .y(t));
  assign y = t * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
check -assert
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=8 %i
design -reset
log -pop

# Test E3: one analysis per module, not per instance.
#
# A module is analyzed with its inputs reading every value their width allows, so the
# answer holds wherever it is instantiated. The cost of that choice is here: the parent
# feeds a zero-extended nibble, which the module itself cannot know, so its 128-bit input
# leaves the output unbounded and nothing narrows. Per-instance analysis would catch it.
log -header "E3: a module's inputs are read as unconstrained, not from the caller"
log -push
design -reset
read_verilog <<EOF
module pass_through(
  input  wire signed [127:0] x,
  output wire signed [127:0] y
);
  assign y = x;
endmodule

module top(
  input  wire [3:0] a,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  wire signed [127:0] t;
  pass_through u (.x({124'b0, a}), .y(t));
  assign y = t * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
check -assert
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=128 %i
design -reset
log -pop

# Test E4: a blackbox has no inside to read, so its output word says only what its width
# says. The narrow port still bounds the reader; the wide one cannot.
log -header "E4: a blackbox is bounded by its port width and nothing more"
log -push
design -reset
read_verilog <<EOF
(* blackbox *)
module narrow_bb(
  output wire signed [7:0] y
);
endmodule

(* blackbox *)
module wide_bb(
  output wire signed [127:0] y
);
endmodule

module top(
  input  wire signed [3:0] c,
  output wire signed [127:0] yn,
  output wire signed [127:0] yw
);
  wire signed [7:0] n;
  wire signed [127:0] w;
  narrow_bb un (.y(n));
  wide_bb uw (.y(w));
  wire signed [127:0] nx = n;
  assign yn = nx * c;
  assign yw = w * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
check -assert
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=8 %i
select -assert-count 1 t:$mul r:A_WIDTH=128 %i
design -reset
log -pop

# Test E5: the analysis is per module, so its cost is paid once however many lanes there
# are, and every reader gets the bound.
log -header "E5: one analysis of a module answers for all of its instances"
log -push
design -reset
read_verilog <<EOF
module lane(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  output wire signed [127:0] y
);
  assign y = a * b;
endmodule

module top(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y0,
  output wire signed [127:0] y1,
  output wire signed [127:0] y2,
  output wire signed [127:0] y3
);
  wire signed [127:0] t0, t1, t2, t3;
  lane u0 (.a(a), .b(b), .y(t0));
  lane u1 (.a(b), .b(a), .y(t1));
  lane u2 (.a(a), .b(c), .y(t2));
  lane u3 (.a(c), .b(b), .y(t3));
  assign y0 = t0 * c;
  assign y1 = t1 * c;
  assign y2 = t2 * c;
  assign y3 = t3 * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
check -assert
opt_signif
select -assert-count 4 t:$mul r:A_WIDTH=8 %i
design -reset
log -pop

# Test E6: an instance is not an operator, whatever its ports are called.
#
# The range rules key on a cell's Y word, and a parameterized instance's type also starts
# with '$', so the only thing that separates the two is whether the design has a module by
# that name. An instance whose output port happens to be named Y would otherwise be read
# as an operator carrying no width parameter at all, which is a range of exactly zero: the
# reader would narrow a live word down to one bit.
log -header "E6: an instance with a port named Y is still an instance"
log -push
design -reset
read_verilog <<EOF
module thing(
  input  wire signed [63:0] a,
  output wire signed [63:0] Y
);
  assign Y = a;
endmodule

module top(
  input  wire signed [63:0] w,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  wire signed [63:0] t;
  thing u (.a(w), .Y(t));
  assign y = t * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
check -assert
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=64 %i
design -reset
log -pop

# Test F1: the summary outlives the body.
#
# A flow that splits a design into module batches blackboxes everything outside the batch
# it is working on, so the lane has no body left by the time the tree reading it is
# narrowed. Recording the range while the body is there is what keeps that boundary
# crossable; without the record the same blackbox says only how wide its port is.
log -header "F1: a recorded range crosses a boundary whose far side is gone"
log -push
design -reset
read_verilog <<EOF
module lane(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  output wire signed [127:0] y
);
  assign y = a * b;
endmodule

module top(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  wire signed [127:0] t;
  lane u (.a(a), .b(b), .y(t));
  assign y = t * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
check -assert
opt_signif -summarize
select -assert-count 1 lane/w:y a:signif_range_signed %i
blackbox lane
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=8 %i

# Without the record there is nothing to read, and the port keeps its declared width
design -reset
read_verilog <<EOF
module lane(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  output wire signed [127:0] y
);
  assign y = a * b;
endmodule

module top(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [127:0] y
);
  wire signed [127:0] t;
  lane u (.a(a), .b(b), .y(t));
  assign y = t * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
check -assert
blackbox lane
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=128 %i
design -reset
log -pop

# Test F2: a range nobody can vouch for is not written down.
#
# A self-accumulating register is unbounded by design, so its port gets no attribute --
# and an attribute left over from an earlier stamp is removed rather than left to be
# believed after the module it described has changed.
log -header "F2: an unbounded port carries no range, stale or otherwise"
log -push
design -reset
read_verilog <<EOF
module top(
  input  wire clk,
  input  wire signed [3:0] a,
  output reg signed [127:0] y
);
  always @(posedge clk) y <= y + a;
endmodule
EOF
proc
opt -full
setattr -set signif_range_signed 1 w:y
select -assert-count 1 w:y a:signif_range_signed %i
opt_signif -summarize -cross-flops
select -assert-count 0 w:y a:signif_range_signed %i
design -reset
log -pop

# Test G1: the cross-boundary rewrite, proven rather than asserted.
#
# equiv_opt cannot be used here the way the rest of this file uses it: the solver has no
# model for a module instance, so it stops at the very boundary under test. Flattening
# both sides after the rewrite gives it one module to reason about, and comparing that
# against the unrewritten design flattened the same way proves the narrowing kept the
# function. The datapath is 32 bits wide because the proof pays for every bit and the
# boundary is what is being tested, not the width.
#
# The recorded-range path in F1 is not provable this way -- a blackbox has no model
# either -- so what pins it is that it narrows to the same width the body-analysis path
# does, which F1 and E1 assert against each other.
log -header "G1: narrowing across a boundary preserves function"
log -push
design -reset
read_verilog <<EOF
module lane(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  output wire signed [31:0] y
);
  assign y = a * b;
endmodule

module top(
  input  wire signed [3:0] a,
  input  wire signed [3:0] b,
  input  wire signed [3:0] c,
  output wire signed [31:0] y
);
  wire signed [31:0] t;
  lane u (.a(a), .b(b), .y(t));
  assign y = t * c;
endmodule
EOF
hierarchy -top top
proc
opt -full
design -save orig

# Narrow with the hierarchy intact, then flatten so the solver has something to model
opt_signif
select -assert-count 1 t:$mul r:A_WIDTH=8 %i
flatten
opt_clean
design -stash gate

design -load orig
flatten
opt_clean
design -copy-from gate -as gate top
equiv_make top gate equiv
equiv_simple
equiv_status -assert
design -reset
log -pop
