# The same design splits the same way however its wires happen to be laid out in memory
read_verilog <<EOT
module top(input [127:0] a, output [127:0] y);
	genvar i;
	for (i = 0; i < 64; i = i + 1) begin : g
		wire [1:0] w;
		assign w = {a[2*i] | a[2*i+1], a[2*i] & a[2*i+1]};
		assign y[2*i+1:2*i] = ~w;
	end
endmodule
EOT
opt_clean
design -save gold

design -load gold
splitnets
write_rtlil splitnets_order_1.out
design -load gold
splitnets
write_rtlil splitnets_order_2.out
!cmp -s splitnets_order_1.out splitnets_order_2.out

design -load gold
splitnets -driver
write_rtlil splitnets_order_3.out
design -load gold
splitnets -driver
write_rtlil splitnets_order_4.out
!cmp -s splitnets_order_3.out splitnets_order_4.out
