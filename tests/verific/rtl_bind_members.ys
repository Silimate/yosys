# RTL bind records each struct-typed register's leaf members on its module, top bits first, so a
# waveform that dumps a register one signal per member can be placed by member name. A nested
# struct is spelled by path, an array of structs by its element, and an interface's modport,
# which lists the interface's own members again, is left out.

verific -cfg db_synopsys_register_names 1
verific -sv rtl_bind_members.sv
verific -import -all -top top
# `?` stands in for the `=`, the `;` and the spaces, which a select pattern cannot spell
select -assert-mod-count 1 A:rtl_bind_members=arr?.a:4:p3:0?.n.p:2:p1:0?.n.q:1?.b:1?bus_q?.data:8:p7:0?.mask:2:p1:0?s?.a:4:p3:0?.n.p:2:p1:0?.n.q:1?.b:1
