# verific -promote_params: a module copied once per generate-loop index elaborates once, with the
# index-driven parameters as input ports, and the design stays equivalent.

verific -sv promote_params.sv
verific -import top
select -assert-mod-count 16 bank*
select -assert-mod-count 16 match*
select -assert-mod-count 16 core*
flatten
async2sync
rename top gold
design -stash gold

# Below the copy count nothing changes
verific -promote_params 18
verific -sv promote_params.sv
verific -import top
select -assert-mod-count 16 bank*
design -reset

verific -promote_params 16
verific -sv promote_params.sv
logger -expect log "Keeping parameter MODE of module bank: it is read in a generate condition\." 1
logger -expect log "Keeping parameter RST of module rbank: it is read in an asynchronous reset value\." 1
logger -expect log "Keeping parameter TAG of module rbank: promoting it would leave 16 of the module's 16 copies\." 1
logger -expect log "Keeping parameter V of module cat: its values don't share one known width and sign\." 1
logger -expect log "Keeping parameter V of module neg: its values don't share one known width and sign\." 1
logger -expect log "Keeping parameter V of module scmp: its values don't share one known width and sign\." 1
logger -expect log "Keeping parameter P of module ones: its values don't share one known width and sign\." 1
logger -expect log "Keeping parameter V of module fill: its values don't share one known width and sign\." 1
logger -expect log "Keeping parameter K of module outer: it sets parameter FN of module fnsel, which a generate condition reads\." 1
logger -expect log "Keeping parameter FN of module fncase: it is read in a generate condition\." 1
logger -expect log "Keeping parameter FN of module fnsum: it is read in a generate condition\." 1
logger -expect log "Promoted parameter\(s\) BASE, FN of module bank \(16 copies\) to input ports\." 1
logger -expect log "Promoted parameter\(s\) K of module leaf \(8 copies\) to input ports\." 1
logger -expect log "Promoted parameter\(s\) K of module pair \(2 copies\) to input ports\." 1
logger -expect log "Promoted parameter\(s\) P of module wide \(16 copies\) to input ports\." 1
logger -expect log "Promoted parameter\(s\) IDX of module match \(16 copies\) to input ports\." 1
logger -expect log "Promoted parameter\(s\) BASE of module core \(16 copies\) to input ports\." 1
logger -expect log "Moved the generate condition\(s\) of module shell that read FN onto parameter\(s\) FN\$cond0\." 1
logger -expect log "Promoted parameter\(s\) BASE, FN of module shell \(16 copies\) to input ports\." 1
logger -expect log "Moved the generate condition\(s\) of module fnsel that read FN onto parameter\(s\) FN\$cond0\." 1
logger -expect log "Promoted parameter\(s\) FN of module fnsel \(32 copies\) to input ports\." 1
logger -expect log "Promoted parameter\(s\) ADDR of module live \(16 copies\) to input ports\." 1
logger -expect log "Keeping parameter ADDR of module dead: no instance elaborates the module\." 1
logger -expect log "Promoted parameter\(s\) V of module mixed \(17 copies\) to input ports\." 1
logger -expect log "Promoted parameter\(s\) ID of module node \(19 copies\) to input ports\." 1
logger -expect log "Promoted parameter\(s\) ID of module nleaf \(19 copies\) to input ports\." 1
logger -expect log "Promoted parameter\(s\) V of module lt \(17 copies\) to input ports\." 1
verific -import top
logger -check-expected
select -assert-mod-count 2 bank*
select -assert-mod-count 1 leaf*
select -assert-mod-count 1 pair*
select -assert-mod-count 1 wide*
select -assert-mod-count 1 match*
select -assert-mod-count 16 rbank*
select -assert-mod-count 1 mixed*
select -assert-mod-count 2 shell*
select -assert-mod-count 2 fnsel*
select -assert-mod-count 16 outer*
select -assert-mod-count 16 fncase*
select -assert-mod-count 16 fnsum*
select -assert-mod-count 1 live*
select -assert-mod-count 0 dead*
select -assert-mod-count 1 core*
select -assert-mod-count 1 node*
select -assert-mod-count 1 nleaf*
select -assert-mod-count 1 lt*
select -assert-mod-count 17 cat*
select -assert-mod-count 17 neg*
select -assert-mod-count 17 scmp*
select -assert-mod-count 17 ones*
select -assert-mod-count 17 fill*
select -assert-count 1 wide/i:P wide/s:64 %i
select -assert-count 1 mixed/i:V mixed/s:64 %i
select -assert-count 1 node/i:ID node/s:32 %i
select -assert-count 1 nleaf/i:ID nleaf/s:32 %i
select -assert-count 1 lt/i:V lt/s:64 %i
select -assert-count 4 bank*/i:FN bank*/i:BASE
flatten
async2sync
rename top gate
design -stash gate

design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -set-init-zero -tempinduct -seq 1 miter
