# RTL bind records each stamped register's declared ranges on its module, unpacked then packed,
# so a waveform that dumps a register one index per signal can be placed by index.

verific -cfg db_synopsys_register_names 1
verific -sv rtl_bind_dims.sv
logger -expect log "RTL bind of module top: 16 register bit\(s\) placed from their register name, 0 from their net, 0 unbound\." 1
verific -import -all -top top
logger -check-expected
# `?` stands in for the `=` and the spaces, which a select pattern cannot spell
select -assert-mod-count 1 A:rtl_bind_dims=a?p3:0?b?p0:3?c?p5:2?m?u0:1,p1:0

# reg_rename places a dump that lists these registers one index per signal by those ranges,
# whatever order it lists them in: bit 0 is the LSB, which is b[3] for `logic [0:3] b`
design -reset
verific -cfg db_synopsys_register_names 1
verific -sv rtl_bind_dims.sv
verific -import -all -top top
splitcells -blast t:$dff
logger -expect log "Bound 16 of 16 Q bit\(s\); unstamped 0, absent 0, unplaced 0, conflict 0, unwired 0" 1
reg_rename -waveform rtl_bind_dims.vcd -scope tb.dut
logger -check-expected
select -assert-count 1 a:rtl_bind=a/4?0? %x:+[Q] w:a?0? %i
select -assert-count 1 a:rtl_bind=a/4?3? %x:+[Q] w:a?3? %i
select -assert-count 1 a:rtl_bind=b/4?0? %x:+[Q] w:b?3? %i
select -assert-count 1 a:rtl_bind=b/4?3? %x:+[Q] w:b?0? %i
select -assert-count 1 a:rtl_bind=c/4?0? %x:+[Q] w:c?2? %i
select -assert-count 1 a:rtl_bind=c/4?3? %x:+[Q] w:c?5? %i
select -assert-count 1 a:rtl_bind=m/4?3? %x:+[Q] w:m?0? %i
select -assert-count 1 a:rtl_bind=m/4?0? %x:+[Q] w:m?1? %i
