# A blackbox is named without its parameters, so its one box takes the ports of every
# parameter set it stands for: each element of a split array port, each port at its widest
verific -sv <<EOT
module leaf #(parameter int N = 1) (
  input  logic [N-1:0][31:0] din,
  input  logic [N*4-1:0] flat,
  output logic [31:0] dout
);
  assign dout = din[0];
endmodule

module top (
  input  logic [7:0][31:0] wide,
  input  logic [31:0] narrow, f8,
  input  logic [3:0] f1,
  output logic [31:0] o8, o1
);
  leaf #(.N(8)) u8 (.din(wide), .flat(f8), .dout(o8));
  leaf u1 (.din(narrow), .flat(f1), .dout(o1));
endmodule
EOT
verific -compile_as_blackbox leaf
verific -import top
hierarchy -top top -check
select -assert-mod-count 1 =A:blackbox
select -assert-count 10 =leaf/x:*
select -assert-count 8 =leaf/i:din* =leaf/s:32 %i
select -assert-count 1 =leaf/i:flat =leaf/s:32 %i
select -assert-count 1 =leaf/o:dout
