# A module name over 4096 characters keeps its first 256 and a hash of the whole name, which the
# module keeps in attribute verific_name; shorter names stay as they are.

verific -sv long_module_name.sv
verific -import top
hierarchy -check -top top
select -assert-mod-count 4 *
select -assert-mod-count 2 m(P=*$????????????????????????????????????????
select -assert-mod-count 2 A:verific_name
select -assert-mod-count 1 m(P=8192'b01)
select -assert-mod-count 0 m(P=8192'b01) A:verific_name %i
