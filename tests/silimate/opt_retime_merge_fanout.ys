# A forward move across an $add folds the registers on the operands into the
# one it leaves on the output. If one of them is read somewhere else, deleting
# it would change that reader, so the flop stays and only the cut is rewired
# to its D. That is the same netlist as cloning a fanout-1 copy and merging
# that copy away.
#
# Split out from opt_retime_add.ys because it used to be a logger -expect error
# case (only one expected error fits per file). It is a real move now.
design -reset
read_verilog -icells <<EOF
module tapped(input clk, input [7:0] a, b, output [7:0] q, tap);
  wire [7:0] ra, rb, s;
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fa (.CLK(clk), .D(a), .Q(ra));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fb (.CLK(clk), .D(b), .Q(rb));
  $add #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    a0 (.A(ra), .B(rb), .Y(s));
  $buf #(.WIDTH(8)) bt (.A(rb), .Y(tap));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fq (.CLK(clk), .D(s), .Q(q));
endmodule
EOF
hierarchy -top tapped
check -assert
# rb feeds the adder and the tap
select -assert-count 2 w:rb %co c:* %i
select -assert-count 3 t:$dff
design -save orig
opt_retime -flop fa -cut a0 -forward
check -assert
# fb is kept for the tap, fa moves onto the sum; register count unchanged
select -assert-count 3 t:$dff
select -assert-count 1 c:fb
select -assert-count 1 c:a0 %x:+[A] w:a %i
select -assert-count 1 c:a0 %x:+[B] w:b %i
select -assert-count 1 c:fa %x:+[Q] w:s %i
select -assert-count 1 c:bt %x:+[A] w:rb %i
select -assert-count 1 c:fb %x:+[Q] w:rb %i
rename tapped gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -set-init-zero -prove-asserts -verify
