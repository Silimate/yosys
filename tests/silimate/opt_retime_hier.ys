# Moves whose two ends are in different modules, made natively.
#
# A register crosses a module boundary by ceasing to be a cell of one module
# and becoming a cell of the other. Nothing is folded and nothing is built:
# the net it used to register becomes a port net registered on the far side,
# and every other net carries the value it carried. That crossing is the only
# new primitive here. A cut named inside the other module is the crossing
# followed by the ordinary move, and a sibling move is the crossing twice.
#
# Four shapes, because data flows two ways and hierarchy goes two ways:
#
#   backward into a child    the flop reads an instance output
#   backward out of a child  the flop reads its module's input port
#   forward into a child     the flop drives an instance input
#   forward out of a child   the flop drives its module's output port
#
# Every section proves at the scope, never at a child. A child boundary is an
# artifact of how a proof is divided up, and a cross-module move is precisely
# a move that relocates one, so comparing hier_dst against hier_dst is
# guaranteed to fail on a correct move. Both sides are flattened first.
#
# hierarchy -top is mandatory in every section. Without it an instance type is
# not a module of the design, Cell::output is false for its outputs, and the
# net the flop reads never enters the driver index - so the boundary is
# invisible and what comes back is a refusal about a missing driver.

# ---------------------------------------------------------------------------
log -header "Backward into a child: the register crosses and nothing else moves"
log -push
design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert
select -assert-count 1 t:$dff
flatten
hierarchy -top top
design -save goldflat

design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert

# The cut is the instance, which names the boundary and nothing else: this is
# the move with no cells in it.
opt_retime -flop f1 -cut u_src -backward
scratchpad -assert opt_retime.moved true
scratchpad -assert-unset opt_retime.refusal
scratchpad -assert opt.did_something true
check -assert

# Still one register, and it is a cell of hier_src now.
select -assert-count 1 t:$dff
select -assert-count 0 top/t:$dff
select -assert-count 1 hier_src/c:f1 %x:+[Q] hier_src/w:y %i
# The adder drives a fresh net and the port is what the register drives, so
# nothing inside hier_src reads a value it did not read before.
select -assert-count 1 hier_src/c:add_s %x:+[Y] hier_src/w:y_pre %i
select -assert-count 1 hier_src/c:f1 %x:+[D] hier_src/w:y_pre %i
# The clock came from the instance connection that was already there; no port
# was punched for it. hier_src gained exactly one net, the internal one above,
# and top's instance connections below are unchanged.
select -assert-count 1 hier_src/c:f1 %x:+[CLK] hier_src/w:clk %i
select -assert-count 5 hier_src/w:* %a
# top kept its ports and its instance connections exactly as they were.
select -assert-count 1 top/c:u_src %x:+[y] top/w:mid %i
select -assert-count 1 top/c:u_dst %x:+[x] top/w:midq %i
# The init went with the register, and is gone from the net that is
# combinational now.
select -assert-count 1 hier_src/w:y a:init=8'h00 %i
select -assert-count 0 top/w:midq a:init %i

flatten
hierarchy -top top
select -assert-count 1 t:$dff
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Forward into a child: the register lands on the input port"
log -push
design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert
flatten
hierarchy -top top
design -save goldflat

design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert
opt_retime -flop f1 -cut u_dst -forward
scratchpad -assert opt_retime.moved true
scratchpad -assert-unset opt_retime.refusal
check -assert

select -assert-count 1 t:$dff
select -assert-count 0 top/t:$dff
select -assert-count 1 hier_dst/c:f1 %x:+[D] hier_dst/w:x %i
select -assert-count 1 hier_dst/c:f1 %x:+[Q] hier_dst/w:x_q %i
select -assert-count 1 hier_dst/c:inv_d %x:+[A] hier_dst/w:x_q %i
select -assert-count 1 hier_dst/w:x_q a:init=8'h00 %i

flatten
hierarchy -top top
select -assert-count 1 t:$dff
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# The other two shapes, from inside the child. kid holds one register at each
# of its ports: fb captures the input port, ff drives the output port. Neither
# has anywhere to go inside kid, and both have somewhere to go in top.
#
# Coming out is the direction that needs nothing of the destination: the
# parent already drives the child's clock, or the child would not be clocked,
# so a register leaving a child always finds its controls waiting for it.
log -header "Backward out of a child: the register leaves through its input port"
log -push
design -reset
read_verilog -icells <<EOF
module kid (clk, x, y, zin, zout);
  input clk;
  input [7:0] x, zin;
  output [7:0] y, zout;
  (* init = 8'h11 *) wire [7:0] xq;
  wire [7:0] zq;
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fb (.CLK(clk), .D(x), .Q(xq));
  $not #(.A_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0)) k_not (.A(xq), .Y(y));
  $xor #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    k_xor (.A(zin), .B(8'h0f), .Y(zq));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) ff (.CLK(clk), .D(zq), .Q(zout));
endmodule
module top (clk, a, b, o1, o2);
  input clk;
  input [7:0] a, b;
  output [7:0] o1, o2;
  wire [7:0] y, zout;
  kid u (.clk(clk), .x(a), .y(y), .zin(b), .zout(zout));
  $buf #(.WIDTH(8)) t1 (.A(y), .Y(o1));
  $buf #(.WIDTH(8)) t2 (.A(zout), .Y(o2));
endmodule
EOF
hierarchy -top top
# ff's Q is the output port itself, which is the shape the forward crossing
# needs, and a port wire is not somewhere a Verilog attribute can be written.
setattr -set init 8'h22 kid/w:zout
select -clear
check -assert
select -assert-count 2 t:$dff
design -save orig
flatten
hierarchy -top top
design -save goldflat

design -load orig
opt_retime -flop fb -cut u -backward
scratchpad -assert opt_retime.moved true
check -assert
select -assert-count 2 t:$dff
# fb is a cell of top now, reading what used to feed the instance port, and
# the instance reads the register instead.
select -assert-count 1 top/c:fb %x:+[D] top/w:a %i
select -assert-count 1 top/c:fb %x:+[Q] top/w:fb_q %i
select -assert-count 1 top/c:u %x:+[x] top/w:fb_q %i
select -assert-count 1 top/w:fb_q a:init=8'h11 %i
# kid's input port is what its inverter reads now, and the init is gone from
# the net that stopped being a register output.
select -assert-count 1 kid/c:k_not %x:+[A] kid/w:xq %i
select -assert-count 0 kid/w:xq a:init %i
select -assert-count 1 kid/t:$dff

flatten
hierarchy -top top
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Forward out of a child: the register leaves through its output port"
log -push
design -load orig
opt_retime -flop ff -cut u -forward
scratchpad -assert opt_retime.moved true
check -assert
select -assert-count 2 t:$dff
# The instance output is unregistered now and top registers it, so the net
# every reader of the instance sees is still one cycle behind zq.
select -assert-count 1 top/c:u %x:+[zout] top/w:ff_d %i
select -assert-count 1 top/c:ff %x:+[D] top/w:ff_d %i
select -assert-count 1 top/c:ff %x:+[Q] top/w:zout %i
select -assert-count 1 top/w:zout a:init=8'h22 %i
select -assert-count 1 kid/t:$dff
select -assert-count 0 kid/w:zout a:init %i

flatten
hierarchy -top top
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# A cut named inside the other module is the crossing and then the ordinary
# move, which is the point of building the crossing as its own step: the walk
# that follows the chain, folds the init and clones the operands is the same
# walk it always was, run in the module the register is now in.
#
# What comes out of the forward case is exactly the netlist
# opt_retime_hier_oracle.ys gets by flattening u_dst first, and exactly the
# relocated form written by hand at the end of this file - three routes to the
# same answer, one of which keeps the hierarchy.
log -header "The cut inside the child: a crossing and then the ordinary move"
log -push
design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert
flatten
hierarchy -top top
design -save goldflat

design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
opt_retime -flop f1 -cut inv_d -forward
scratchpad -assert opt_retime.moved true
check -assert
select -assert-count 1 t:$dff
select -assert-count 0 top/t:$dff
select -assert-count 1 hier_dst/c:inv_d %x:+[A] hier_dst/w:x %i
select -assert-count 1 hier_dst/c:f1 %x:+[D] hier_dst/w:x_q %i
select -assert-count 1 hier_dst/c:f1 %x:+[Q] hier_dst/w:z %i
# 8'h00 crossed a $not on the way, so the register starts at ~0 - folded by
# the ordinary move, on the far side of a boundary it did not have to know
# about.
select -assert-count 1 hier_dst/w:z a:init=8'hff %i

flatten
hierarchy -top top
select -assert-count 1 t:$dff
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset

# Backward the same way. The cut has a live second operand, so the ordinary
# move clones onto it, and both registers end up in hier_src.
design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
opt_retime -flop f1 -cut add_s -backward
scratchpad -assert opt_retime.moved true
check -assert
select -assert-count 2 t:$dff
select -assert-count 2 hier_src/t:$dff
select -assert-count 0 top/t:$dff
select -assert-count 1 hier_src/c:f1_B %x:+[D] hier_src/w:b %i
select -assert-count 1 hier_src/c:add_s %x:+[Y] hier_src/w:y %i

flatten
hierarchy -top top
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# Sibling to sibling: out of one child, across the parent, into the other. The
# parent is a place the register passes through rather than a place it stops,
# and the only reason it can pass through is that a crossing is a complete
# move on its own and composes with the next one.
#
# Asserted in both of the forms the retiming has, as a pair. The pass produces
# the relocated form, because it moves registers and not logic. The form under
# it keeps the register in sib_a and brings the inverter across instead, which
# is the same retiming, needs no clock in the destination, and is the one to
# prefer when the result has to be mirrored back into RTL.
log -header "Sibling to sibling, in both of its forms"
log -push
design -reset
read_verilog -icells <<EOF
module sib_a (clk, x, y);
  input clk;
  input [7:0] x;
  output [7:0] y;
  wire [7:0] t;
  $add #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    a_add (.A(x), .B(8'h03), .Y(t));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fa (.CLK(clk), .D(t), .Q(y));
endmodule
module sib_b (clk, p, q);
  input clk;
  input [7:0] p;
  output [7:0] q;
  $not #(.A_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0)) b_not (.A(p), .Y(q));
endmodule
module top (clk, a, out);
  input clk;
  input [7:0] a;
  output [7:0] out;
  wire [7:0] m;
  sib_a u_a (.clk(clk), .x(a), .y(m));
  sib_b u_b (.clk(clk), .p(m), .q(out));
endmodule
EOF
hierarchy -top top
setattr -set init 8'h00 sib_a/w:y
select -clear
check -assert
flatten
hierarchy -top top
select -assert-count 1 t:$dff
design -save goldflat

design -reset
read_verilog -icells <<EOF
module sib_a (clk, x, y);
  input clk;
  input [7:0] x;
  output [7:0] y;
  wire [7:0] t;
  $add #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    a_add (.A(x), .B(8'h03), .Y(t));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fa (.CLK(clk), .D(t), .Q(y));
endmodule
module sib_b (clk, p, q);
  input clk;
  input [7:0] p;
  output [7:0] q;
  $not #(.A_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0)) b_not (.A(p), .Y(q));
endmodule
module top (clk, a, out);
  input clk;
  input [7:0] a;
  output [7:0] out;
  wire [7:0] m;
  sib_a u_a (.clk(clk), .x(a), .y(m));
  sib_b u_b (.clk(clk), .p(m), .q(out));
endmodule
EOF
hierarchy -top top
setattr -set init 8'h00 sib_a/w:y
select -clear
opt_retime -flop fa -cut b_not -forward
scratchpad -assert opt_retime.moved true
check -assert
# one register, two boundaries crossed, and it is in the far sibling
select -assert-count 1 t:$dff
select -assert-count 0 sib_a/t:$dff
select -assert-count 0 top/t:$dff
select -assert-count 1 sib_b/c:fa %x:+[D] sib_b/w:p_q %i
select -assert-count 1 sib_b/c:fa %x:+[Q] sib_b/w:q %i
select -assert-count 1 sib_b/c:b_not %x:+[A] sib_b/w:p %i
select -assert-count 1 sib_b/w:q a:init=8'hff %i

flatten
hierarchy -top top
select -assert-count 1 t:$dff
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset

# The same retiming with the logic moved instead: sib_a keeps its register and
# takes the inverter, sib_b passes its input through. The register never
# changes modules, so no clock has to be found for it and no init crosses a
# boundary - and it proves against the same gold.
read_verilog -icells <<EOF
module sib_a (clk, x, y);
  input clk;
  input [7:0] x;
  output [7:0] y;
  wire [7:0] t, nt;
  $add #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    a_add (.A(x), .B(8'h03), .Y(t));
  $not #(.A_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0)) a_not (.A(t), .Y(nt));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fa (.CLK(clk), .D(nt), .Q(y));
endmodule
module sib_b (clk, p, q);
  input clk;
  input [7:0] p;
  output [7:0] q;
  $buf #(.WIDTH(8)) b_not (.A(p), .Y(q));
endmodule
module top (clk, a, out);
  input clk;
  input [7:0] a;
  output [7:0] out;
  wire [7:0] m;
  sib_a u_a (.clk(clk), .x(a), .y(m));
  sib_b u_b (.clk(clk), .p(m), .q(out));
endmodule
EOF
hierarchy -top top
setattr -set init 8'hff sib_a/w:y
select -clear
check -assert
select -assert-count 1 sib_a/t:$dff
flatten
hierarchy -top top
select -assert-count 1 t:$dff
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop
