# The first hierarchical opt_retime test: what a module boundary does to a
# move today, and what the move it blocks is supposed to come out as.
#
# opt_retime is single-module throughout. It builds one SigMap over the flop's
# module, indexes that module's cell outputs, and walks cells inside it, so a
# boundary is not a case it declines: it is a place where its own questions
# stop having answers. The three refusals below are that showing through, and
# each of them is a different wrong answer:
#
#   - an instance named as the cut reads as a cell type with no data inputs,
#     so the move is "unsupported" the way an unlisted gate would be;
#   - a before-path that leaves the module reads as a net with no cell Y
#     behind it, so the move is an "invalid request" the way a cut on the
#     wrong side of the flop is;
#   - a cut inside a child is not in the flop's module at all, so it is a
#     command error and the script stops.
#
# None of those is a statement about retiming, and the last section shows why:
# the move the first two refuse is legal, it keeps the flop count, and it has
# two equally good expressions in hierarchical RTL. Pinning the refusals here
# is the reproduction the native cross-module work is measured against, and
# each of them changes as that work lands.
#
# Equivalence is proved at the scope and never at a child. A child boundary is
# an artifact of how the proof is divided up, not a specification boundary,
# and a cross-module move is precisely a move that relocates one: comparing
# hier_dst against hier_dst is guaranteed to fail on a correct move. Both
# sides are flattened first, so what is compared is top's behaviour.

# ---------------------------------------------------------------------------
# hierarchy -top is mandatory in every section. Without it hier_src is not a
# module of the design, Cell::output is false for u_src's y, and mid never
# enters the driver index - so the flop's D looks undriven and every move
# below refuses for a reason that is about the missing elaboration rather than
# about the boundary.
log -header "Today: an instance named as the cut is a type with no data inputs"
log -push
design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert
select -assert-count 1 t:$dff

# Backward across u_src is the move that puts the register inside hier_src.
# What comes back is the answer for a gate whose type is not in data_inputs -
# a cell the pass could move across if someone added it to a list - which is
# not what an instance is.
opt_retime -flop f1 -cut u_src -backward
scratchpad -assert opt_retime.moved false
scratchpad -assert opt_retime.refusal "Cut cell u_src has type hier_src, which opt_retime cannot move across (unsupported)."
scratchpad -assert-unset opt.did_something

# Untouched, in every module the move would have reached. A cross-module move
# spans two modules plus the instance site, so a refusal has three places to
# leave something behind rather than one.
select -assert-count 1 t:$dff
select -assert-count 1 top/c:f1 %x:+[D] top/w:mid %i
select -assert-count 1 top/c:f1 %x:+[Q] top/w:midq %i
select -assert-count 1 top/c:u_src %x:+[y] top/w:mid %i
select -assert-count 1 top/c:u_dst %x:+[x] top/w:midq %i
select -assert-count 1 hier_src/c:add_s %x:+[Y] hier_src/w:y %i
select -assert-count 1 hier_dst/c:inv_d %x:+[A] hier_dst/w:x %i
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Today: the same for a forward move into the instance downstream"
log -push
design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert
opt_retime -flop f1 -cut u_dst -forward
scratchpad -assert opt_retime.moved false
scratchpad -assert opt_retime.refusal "Cut cell u_dst has type hier_dst, which opt_retime cannot move across (unsupported)."
scratchpad -assert-unset opt.did_something
select -assert-count 1 t:$dff
select -assert-count 1 top/c:f1 %x:+[Q] top/w:midq %i
select -assert-count 1 top/c:u_dst %x:+[x] top/w:midq %i
select -assert-count 1 hier_dst/c:inv_d %x:+[A] hier_dst/w:x %i
design -reset
log -pop

# ---------------------------------------------------------------------------
# Naming a cell of top on the far side of u_src asks for a move whose path
# leaves the module and comes back. The walk gives out one hop in, at mid,
# because the cell driving it is an instance and its output port is y rather
# than Y - so what the pass reports is a missing driver, and calls the request
# invalid. The request is well formed; the walk is what cannot follow it.
log -header "Today: a before-path that leaves the module reads as no driver"
log -push
design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert
opt_retime -flop f1 -cut xor_t -backward
scratchpad -assert opt_retime.moved false
scratchpad -assert opt_retime.refusal "The before-path of flop f1 is not a unique cell Y at \mid (invalid request)."
scratchpad -assert-unset opt.did_something
select -assert-count 1 t:$dff
select -assert-count 1 top/c:f1 %x:+[D] top/w:mid %i
select -assert-count 1 top/c:xor_t %x:+[Y] top/w:pre %i
select -assert-count 1 top/c:u_src %x:+[a] top/w:pre %i
design -reset
log -pop

# ---------------------------------------------------------------------------
# The move those refusals are standing in front of, written by hand in both of
# the forms hierarchical RTL has for it.
#
# The retiming is one step forward across the inverter: out goes from
# ~reg(mid) to reg(~mid). The inverter is inside hier_dst and the register is
# in top, so the step crosses the boundary, and there are two ways to write
# the result:
#
#   relocated - the register moves into hier_dst and lands past the inverter.
#               top hands mid straight to the instance.
#   logic moved - the register stays in top and the inverter comes up to meet
#               it. hier_dst is left passing its input through.
#
# They are the same retiming: same flop count, same latency to out, same
# critical path. What differs is which module owns the state, which is why the
# second form is the one to prefer in RTL - it needs no clock in the
# destination and no init carried across a boundary - and why both have to
# prove. A proof that only accepted one of them would be pinning a diff style
# rather than a behaviour.
#
# The init moves with the register either way: midq starts at 8'h00, so the
# register holding ~mid starts at 8'hff and out reads the same on cycle 0 as
# it did before. Proved without -set-init-zero for that reason - zeroing both
# sides would pass over a fold that was never done.
log -header "The blocked move, written both ways, each proved at the scope"
log -push
design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert
flatten
# flatten leaves the children behind as modules nothing instantiates; -top
# drops them, so what is saved is one module and design -import cannot collide
# with the gate side's own hier_src and hier_dst.
hierarchy -top top
select -assert-count 1 t:$dff
design -save goldflat

design -reset
read_verilog -icells <<EOF
module hier_src (clk, a, b, y);
  input clk;
  input [7:0] a, b;
  output [7:0] y;
  $add #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    add_s (.A(a), .B(b), .Y(y));
endmodule
// the register relocated: it crossed the boundary and landed past the
// inverter, so hier_dst owns the state and z is a registered output
module hier_dst (clk, x, z);
  input clk;
  input [7:0] x;
  output [7:0] z;
  wire [7:0] nx;
  $not #(.A_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0)) inv_d (.A(x), .Y(nx));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f1 (.CLK(clk), .D(nx), .Q(z));
endmodule
module top (clk, a, b, c, out);
  input clk;
  input [7:0] a, b, c;
  output [7:0] out;
  wire [7:0] pre, mid;
  $xor #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    xor_t (.A(a), .B(c), .Y(pre));
  hier_src u_src (.clk(clk), .a(pre), .b(b), .y(mid));
  hier_dst u_dst (.clk(clk), .x(mid), .z(out));
endmodule
EOF
hierarchy -top top
# the folded init: ~8'h00, on the relocated register's Q inside the child
setattr -set init 8'hff hier_dst/w:z
check -assert
flatten
hierarchy -top top
# a retimed register is still one register
select -assert-count 1 t:$dff
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset

read_verilog -icells <<EOF
module hier_src (clk, a, b, y);
  input clk;
  input [7:0] a, b;
  output [7:0] y;
  $add #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    add_s (.A(a), .B(b), .Y(y));
endmodule
// the logic moved instead: the inverter came up into top and hier_dst passes
// its input through, so top still owns the state
module hier_dst (clk, x, z);
  input clk;
  input [7:0] x;
  output [7:0] z;
  $buf #(.WIDTH(8)) inv_d (.A(x), .Y(z));
endmodule
module top (clk, a, b, c, out);
  input clk;
  input [7:0] a, b, c;
  output [7:0] out;
  wire [7:0] pre, mid, nmid;
  (* init = 8'hff *) wire [7:0] midq;
  $xor #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    xor_t (.A(a), .B(c), .Y(pre));
  hier_src u_src (.clk(clk), .a(pre), .b(b), .y(mid));
  $not #(.A_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0)) inv_t (.A(mid), .Y(nmid));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f1 (.CLK(clk), .D(nmid), .Q(midq));
  hier_dst u_dst (.clk(clk), .x(midq), .z(out));
endmodule
EOF
hierarchy -top top
check -assert
# the register never left top
select -assert-count 1 top/t:$dff
flatten
hierarchy -top top
select -assert-count 1 t:$dff
rename top gate
design -import goldflat -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# logger -expect error exits yosys successfully, so this has to come last.
#
# The cut is looked up in the module the flop was found in and nowhere else,
# so naming a cell of hier_src is not a refused move - it is a cut that does
# not exist. A driver sweeping candidate moves gets a dead script rather than
# a reason it can sort, which is the third and worst of today's answers.
log -header "Error: a cut inside a child is not a cell of the flop's module"
design -reset
read_verilog -icells opt_retime_hier.v
hierarchy -top top
check -assert
logger -expect error "Cut cell 'add_s' not found in module top." 1
opt_retime -flop f1 -cut add_s -backward
