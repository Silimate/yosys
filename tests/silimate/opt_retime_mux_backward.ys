# Backward across $mux, the first cut with a third operand.
#
# reg(S ? B : A) is (reg S) ? (reg B) : (reg A): the identity behind every
# backward move never cared how many operands the cell has. What the third one
# costs is cycle 0, and the select is what pays for it. Pin the cloned select
# at the constant that picks the port the path came in on and the mux is that
# port, so the path flop keeps the value it already held and the other data
# clone can start at x.
#
# That also makes a clone narrower than the flop, the select being one bit
# while the flop is WIDTH, and it is the only port allowed to be.
#
# A live select at every level is what used to stop a chain at one mux. Clones
# are placed at every hop here, not just at the cut, so a whole mux tree walks
# back in a single move.

# ---------------------------------------------------------------------------
log -header "Backward: \$mux, path on A, cloning the select and B"
log -push
design -reset
read_verilog -icells <<EOF
module muxa(input clk, input [7:0] a, b, input s, output [7:0] q);
  wire [7:0] y;
  $mux #(.WIDTH(8)) u0 (.A(a), .B(b), .S(s), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top muxa
setattr -set init 8'h5a w:q
check -assert
design -save orig
opt_retime -flop f -cut u0 -backward
check -assert
# the flop and two clones, one of them a single bit
select -assert-count 3 t:$dff
select -assert-count 1 c:f %x:+[D] w:a %i
select -assert-count 1 c:f_B %x:+[D] w:b %i
select -assert-count 1 c:f_S %x:+[D] w:s %i
select -assert-count 1 c:u0 %x:+[Y] w:q %i
# a mux is its own inverse once the select picks the path, so the flop keeps
# 8'h5a; the select clone starts at 0 to pick A and B's clone is a don't-care
select -assert-count 1 w:y a:init=8'h5a %i
select -assert-count 1 w:f_S_q a:init=1'0 %i
rename muxa gate
design -import orig -as gold
setattr -set init 8'h5a gold/w:q
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Backward: \$mux, path on B, so the select clone starts at 1"
log -push
design -reset
read_verilog -icells <<EOF
module muxb(input clk, input [7:0] b, input s, output [7:0] q);
  wire [7:0] y;
  $mux #(.WIDTH(8)) u0 (.A(8'hc3), .B(b), .S(s), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top muxb
setattr -set init 8'h5a w:q
check -assert
design -save orig
opt_retime -flop f -cut u0 -backward
check -assert
# A stays constant, so only the select is cloned
select -assert-count 2 t:$dff
select -assert-count 1 c:f %x:+[D] w:b %i
select -assert-count 1 c:f_S %x:+[D] w:s %i
select -assert-count 1 w:y a:init=8'h5a %i
select -assert-count 1 w:f_S_q a:init=1'1 %i
rename muxb gate
design -import orig -as gold
setattr -set init 8'h5a gold/w:q
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# The move the single-clone-at-the-cut rule could not make: every level of a
# mux tree has a live select, so a chain that only allowed a clone at the cut
# stopped after one level no matter how deep the tree was.
log -header "Backward: two levels of a mux tree in one move"
log -push
design -reset
read_verilog -icells <<EOF
module muxtree(input clk, input [7:0] a, b, c, d, input s0, s1, s2, output [7:0] q);
  wire [7:0] m0, m1, m2;
  $mux #(.WIDTH(8)) u0 (.A(a),  .B(b),  .S(s0), .Y(m0));
  $mux #(.WIDTH(8)) u1 (.A(c),  .B(d),  .S(s1), .Y(m1));
  $mux #(.WIDTH(8)) u2 (.A(m0), .B(m1), .S(s2), .Y(m2));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(m2), .Q(q));
endmodule
EOF
hierarchy -top muxtree
setattr -set init 8'h5a w:q
check -assert
design -save orig
opt_retime -flop f -cut u0 -backward
check -assert
# f plus a clone on each operand the path missed, at both hops. A clone away
# from the cut names its cell too, since every level clones a port called S.
select -assert-count 5 t:$dff
select -assert-count 1 c:f %x:+[D] w:a %i
select -assert-count 1 c:f_B %x:+[D] w:b %i
select -assert-count 1 c:f_S %x:+[D] w:s0 %i
select -assert-count 1 c:f_u2_B %x:+[D] w:m1 %i
select -assert-count 1 c:f_u2_S %x:+[D] w:s2 %i
# u1 is untouched and still feeds the clone combinationally
select -assert-count 1 c:u1 %x:+[Y] w:m1 %i
select -assert-count 1 c:u2 %x:+[Y] w:q %i
# both select clones pick A, the port the path runs through at both hops
select -assert-count 1 w:f_S_q a:init=1'0 %i
select -assert-count 1 w:f_u2_S_q a:init=1'0 %i
rename muxtree gate
design -import orig -as gold
setattr -set init 8'h5a gold/w:q
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# The clone inherits the enable and the reset net, and the reset value crosses
# the mux the same way the init does.
log -header "Backward: \$mux carrying an enable and a sync reset"
log -push
design -reset
read_verilog -icells <<EOF
module muxrst(input clk, rst, en, input [3:0] a, b, input s, output [3:0] q);
  wire [3:0] y;
  $mux #(.WIDTH(4)) u0 (.A(a), .B(b), .S(s), .Y(y));
  $sdffce #(.WIDTH(4), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1),
            .SRST_POLARITY(1'b1), .SRST_VALUE(4'ha))
    f (.CLK(clk), .EN(en), .SRST(rst), .D(y), .Q(q));
endmodule
EOF
hierarchy -top muxrst
setattr -set init 4'h3 w:q
check -assert
design -save orig
opt_retime -flop f -cut u0 -backward
check -assert
select -assert-count 3 t:$sdffce
# the flop keeps both of its values; the select clone starts and resets at 0,
# so a reset cycle still hands the mux the port the flop is holding. The SAT
# proof below drives rst and en freely, which is what checks the reset value.
select -assert-count 1 w:y a:init=4'h3 %i
select -assert-count 1 c:f %x:+[D] w:a %i
select -assert-count 1 c:f_S %x:+[D] w:s %i
select -assert-count 1 w:f_S_q a:init=1'0 %i
rename muxrst gate
design -import orig -as gold
setattr -set init 4'h3 gold/w:q
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 10 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# With both data ports constant there is no data port left to slide onto, and
# the select is not a substitute: it is the operand whose clone pays for cycle
# 0, so there would be no fixed starting value left to give the other two.
log -header "Refused: backward does not slide onto a \$mux select"
design -reset
read_verilog -icells <<EOF
module selpath(input clk, input s, output [7:0] q);
  wire [7:0] y;
  $mux #(.WIDTH(8)) u0 (.A(8'haa), .B(8'h55), .S(s), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top selpath
check -assert
opt_retime -flop f -cut u0 -backward
scratchpad -assert opt_retime.moved false
scratchpad -assert opt_retime.refusal "Both data inputs of u0 are constant or already registered, so flop f would have to slide onto the select, which opt_retime does not do yet."
