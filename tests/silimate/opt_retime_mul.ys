# Moves across $mul.
#
# Forward, $mul is the same merge as $add: two data inputs, a pure function,
# and Y can be wider than either operand. What is worth its own test is
# signedness. Unsigned 4'hf * 4'he is 8'hd2; signed they are -1 and -2 and
# the product is 8'h02. A fold that ignored A_SIGNED/B_SIGNED would still
# look like a successful move, so the signed section asserts the init value
# directly.
#
# Backward is the $and case with arithmetic instead of a mask. An odd
# constant has a unique inverse. An even one has several preimages or none,
# and the move only needs one: it leaves the flop holding a value the $mul
# turns back into the old one on the first cycle. A live other operand gets
# a clone that starts at 1, the identity of the cut.

# ---------------------------------------------------------------------------
log -header "Forward: unsigned \$mul, truncated product"
log -push
design -reset
read_verilog -icells <<EOF
module muldes(input clk, input [3:0] a, b, output [3:0] q);
  wire [3:0] ra, rb, y;
  $dff #(.WIDTH(4), .CLK_POLARITY(1'b1)) fa (.CLK(clk), .D(a), .Q(ra));
  $dff #(.WIDTH(4), .CLK_POLARITY(1'b1)) fb (.CLK(clk), .D(b), .Q(rb));
  $mul #(.A_WIDTH(4), .B_WIDTH(4), .Y_WIDTH(4), .A_SIGNED(0), .B_SIGNED(0))
    m0 (.A(ra), .B(rb), .Y(y));
  $dff #(.WIDTH(4), .CLK_POLARITY(1'b1)) fq (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top muldes
check -assert
select -assert-count 3 t:$dff
design -save orig
opt_retime -flop fa -cut m0 -forward
check -assert
select -assert-count 2 t:$dff
select -assert-count 0 c:fb
select -assert-count 1 c:m0 %x:+[A] w:a %i
select -assert-count 1 c:m0 %x:+[B] w:b %i
select -assert-count 1 c:m0 %x:+[Y] w:ra %i
select -assert-count 1 c:fa %x:+[D] w:ra %i
select -assert-count 1 c:fa %x:+[Q] w:y %i
rename muldes gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -set-init-zero -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Forward: unsigned \$mul, full product, 4 bits to 8"
log -push
design -reset
read_verilog -icells <<EOF
module fullmul(input clk, input [3:0] a, b, output [7:0] q);
  wire [3:0] ra, rb;
  wire [7:0] y;
  $dff #(.WIDTH(4), .CLK_POLARITY(1'b1)) fa (.CLK(clk), .D(a), .Q(ra));
  $dff #(.WIDTH(4), .CLK_POLARITY(1'b1)) fb (.CLK(clk), .D(b), .Q(rb));
  $mul #(.A_WIDTH(4), .B_WIDTH(4), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    m0 (.A(ra), .B(rb), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fq (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top fullmul
check -assert
select -assert-count 3 t:$dff
design -save orig
opt_retime -flop fa -cut m0 -forward
check -assert
# two 4-bit operand registers became one 8-bit register: 16 register bits to 16
select -assert-count 2 t:$dff
select -assert-count 0 c:fb
select -assert-count 1 c:m0 %x:+[A] w:a %i
select -assert-count 1 c:m0 %x:+[B] w:b %i
select -assert-count 1 c:fa %x:+[Q] w:y %i
select -assert-count 1 c:fq %x:+[D] w:y %i
select -assert-count 1 c:m0 %x:+[Y] w:fa_retimed %i
select -assert-count 1 c:fa %x:+[D] w:fa_retimed %i
rename fullmul gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -set-init-zero -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Forward: signed \$mul, folding -1 * -2 to 2"
log -push
design -reset
read_verilog -icells <<EOF
module signedmul(input clk, input [3:0] a, b, output [7:0] q);
  (* init = 4'hf *) wire [3:0] ra;
  (* init = 4'he *) wire [3:0] rb;
  wire [7:0] y;
  $dff #(.WIDTH(4), .CLK_POLARITY(1'b1)) fa (.CLK(clk), .D(a), .Q(ra));
  $dff #(.WIDTH(4), .CLK_POLARITY(1'b1)) fb (.CLK(clk), .D(b), .Q(rb));
  $mul #(.A_WIDTH(4), .B_WIDTH(4), .Y_WIDTH(8), .A_SIGNED(1), .B_SIGNED(1))
    m0 (.A(ra), .B(rb), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fq (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top signedmul
# miter -make_assert compares cycle 0, and two undefined registers are
# independent free variables that need not agree there, so the observing
# register needs a defined start as well. Set before the save, so gold and
# gate get the same one.
setattr -set init 8'h00 w:q
check -assert
select -assert-count 3 t:$dff
design -save orig
opt_retime -flop fa -cut m0 -forward
check -assert
select -assert-count 2 t:$dff
select -assert-count 0 c:fb
# 4'hf and 4'he as signed 4-bit are -1 and -2; the 8-bit product is 2.
# The unsigned product of those bit patterns is 8'hd2, so this is the
# assertion that would fail if the fold ignored A_SIGNED/B_SIGNED.
select -assert-count 1 w:y a:init=8'h02 %i
select -assert-count 0 w:ra a:init %i
select -assert-count 0 w:rb a:init %i
rename signedmul gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# 3 * 171 = 513 = 1 (mod 256), so init 1 folds to 8'hab.
log -header "Backward: \$mul against an odd constant"
log -push
design -reset
read_verilog -icells <<EOF
module mulc(input clk, input [7:0] a, output [7:0] q);
  wire [7:0] y;
  $mul #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    m0 (.A(a), .B(8'd3), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top mulc
setattr -set init 8'h01 w:q
check -assert
design -save orig
opt_retime -flop f -cut m0 -backward
check -assert
select -assert-count 1 t:$dff
select -assert-count 1 c:f %x:+[D] w:a %i
select -assert-count 1 c:m0 %x:+[Y] w:q %i
select -assert-count 1 w:y a:init=8'hab %i
rename mulc gate
design -import orig -as gold
setattr -set init 8'h01 gold/w:q
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# Every \$mul case either side of this one is a single hop, so the modular
# inverse is the whole fold. A chain composes one inverse per hop, innermost
# last, and getting that order wrong still type-checks: both hops here are
# 8 bits wide and both are invertible. 0xd1 back through + 7 is 0xca, and 0xca
# back through * 3 is 0xee, since 3 * 0xee = 0x2ca and the low byte is 0xca.
log -header "Backward: folding an init through \$mul and \$add together"
log -push
design -reset
read_verilog -icells <<EOF
module mulchain(input clk, input [7:0] a, output [7:0] q);
  wire [7:0] p, y;
  $mul #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    m0 (.A(a), .B(8'd3), .Y(p));
  $add #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    a0 (.A(p), .B(8'd7), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top mulchain
setattr -set init 8'hd1 w:q
check -assert
design -save orig
opt_retime -flop f -cut m0 -backward
check -assert
select -assert-count 1 t:$dff
# The register lands ahead of both hops, and both still compute in order
select -assert-count 1 c:f %x:+[D] w:a %i
select -assert-count 1 c:m0 %x:+[Y] w:p %i
select -assert-count 1 c:a0 %x:+[Y] w:q %i
# The two inverses composed: 0xd1 - 7 = 0xca, then 0xca / 3 = 0xee
select -assert-count 1 w:y a:init=8'hee %i
rename mulchain gate
design -import orig -as gold
setattr -set init 8'hd1 gold/w:q
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# 2 has no inverse, but 8'h0a is in the image: 5 * 2 = 10. The high bit of
# the preimage is free; the pass leaves it 0.
log -header "Backward: \$mul against an even constant, init in the image"
log -push
design -reset
read_verilog -icells <<EOF
module muleven(input clk, input [7:0] a, output [7:0] q);
  wire [7:0] y;
  $mul #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    m0 (.A(a), .B(8'd2), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top muleven
setattr -set init 8'h0a w:q
check -assert
design -save orig
opt_retime -flop f -cut m0 -backward
check -assert
select -assert-count 1 t:$dff
select -assert-count 1 c:f %x:+[D] w:a %i
select -assert-count 1 c:m0 %x:+[Y] w:q %i
select -assert-count 1 w:y a:init=8'h05 %i
rename muleven gate
design -import orig -as gold
setattr -set init 8'h0a gold/w:q
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# 4'hf as a signed 4-bit other operand is -1, so init 1 folds to 8'hff.
# Zero-extended it would be 15, and 1 * inv(15) is 8'hef, which is the
# assertion that would fail if the inverse ignored B_SIGNED.
log -header "Backward: signed \$mul, folding 1 / -1 to -1"
log -push
design -reset
read_verilog -icells <<EOF
module mulsigned(input clk, input [7:0] a, output [7:0] q);
  wire [7:0] y;
  $mul #(.A_WIDTH(8), .B_WIDTH(4), .Y_WIDTH(8), .A_SIGNED(1), .B_SIGNED(1))
    m0 (.A(a), .B(4'hf), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top mulsigned
setattr -set init 8'h01 w:q
check -assert
design -save orig
opt_retime -flop f -cut m0 -backward
check -assert
select -assert-count 1 c:f %x:+[D] w:a %i
select -assert-count 1 c:m0 %x:+[Y] w:q %i
select -assert-count 1 w:y a:init=8'hff %i
rename mulsigned gate
design -import orig -as gold
setattr -set init 8'h01 gold/w:q
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Backward: clone onto a live operand of \$mul, starting at 1"
log -push
design -reset
read_verilog -icells <<EOF
module mullive(input clk, input [7:0] a, b, output [7:0] q);
  wire [7:0] y;
  $mul #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    m0 (.A(a), .B(b), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top mullive
setattr -set init 8'h5a w:q
check -assert
design -save orig
opt_retime -flop f -cut m0 -backward
check -assert
select -assert-count 2 t:$dff
select -assert-count 1 c:f %x:+[D] w:a %i
select -assert-count 1 c:f_B %x:+[D] w:b %i
select -assert-count 1 c:m0 %x:+[Y] w:q %i
select -assert-count 1 w:y a:init=8'h5a %i
select -assert-count 1 w:f_B_q a:init=8'h01 %i
rename mullive gate
design -import orig -as gold
setattr -set init 8'h5a gold/w:q
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# 8'h0b is odd, so no input times 2 produces it and there is nothing to leave
# the flop holding.
log -header "Refused: an odd stored value has no preimage under * 2"
design -reset
read_verilog -icells <<EOF
module mulevenodd(input clk, input [7:0] a, output [7:0] q);
  wire [7:0] y;
  $mul #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    m0 (.A(a), .B(8'd2), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) f (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top mulevenodd
setattr -set init 8'h0b w:q
check -assert
opt_retime -flop f -cut m0 -backward
scratchpad -assert opt_retime.moved false
scratchpad -assert opt_retime.refusal "Cell m0 has no input on A that produces 8'00001011, so a backward move has no stored value to leave behind."

# ---------------------------------------------------------------------------
# $div used to sit here as a type left out of the allowlist; it is a forward
# cut now, proved in opt_retime_arith.ys. What is still refused is a gate-level
# cut, and that one is a boundary rather than a to-do: this pass retimes
# word-level IR, before splitcells, so a $_AND_ is not something it expects to
# meet. The same move on the $and this gate would come from is in
# opt_retime_cmp.ys.
log -header "Refused: forward across a gate-level \$_AND_"
design -reset
read_verilog -icells <<EOF
module gatecut(input clk, input a, b, output q);
  wire ra, rb, y;
  $dff #(.WIDTH(1), .CLK_POLARITY(1'b1)) fa (.CLK(clk), .D(a), .Q(ra));
  $dff #(.WIDTH(1), .CLK_POLARITY(1'b1)) fb (.CLK(clk), .D(b), .Q(rb));
  $_AND_ g0 (.A(ra), .B(rb), .Y(y));
  $dff #(.WIDTH(1), .CLK_POLARITY(1'b1)) fq (.CLK(clk), .D(y), .Q(q));
endmodule
EOF
hierarchy -top gatecut
check -assert
opt_retime -flop fa -cut g0 -forward
scratchpad -assert opt_retime.moved false
scratchpad -assert opt_retime.refusal "Cut cell g0 has type $_AND_, which opt_retime cannot move across yet."
