# reg_rename files a modport's scope, which lists its interface's members again under the same
# handles, as those members, not as more of them. reg_rename_modport_alias.vcd dumps scope tb.dut.
#
#   object  dump                                             expected
#   bus_q   data, mask, and each again under transmit and    bound*6, as data + mask
#           receive with the same handles
#   pair    a and b sharing one handle                       bound*2: two members, not one

read_rtlil <<EOT
module \top
  wire input 1 \clk
  wire width 6 input 2 \d6
  wire width 2 input 3 \d2
  wire width 6 \bus_q_q
  wire width 2 \pair_q
  attribute \rtl_bind "bus_q/6[0:5]"
  cell $dff \bus_q_ff
    parameter \CLK_POLARITY 1
    parameter \WIDTH 6
    connect \CLK \clk
    connect \D \d6
    connect \Q \bus_q_q
  end
  attribute \rtl_bind "pair/2[0:1]"
  cell $dff \pair_ff
    parameter \CLK_POLARITY 1
    parameter \WIDTH 2
    connect \CLK \clk
    connect \D \d2
    connect \Q \pair_q
  end
end
EOT
hierarchy -top top

logger -expect log "Bound 8 of 8 Q bit\(s\); unstamped 0, absent 0, unplaced 0, conflict 0, unwired 0" 1
reg_rename -waveform reg_rename_modport_alias.vcd -scope tb.dut
logger -check-expected

select -assert-count 1 c:bus_q_ff a:rtl_bind_status=bound*6 %i
select -assert-count 2 w:bus_q.data w:bus_q.mask %u
select -assert-count 1 c:pair_ff a:rtl_bind_status=bound*2 %i
