log -header "Negative case: SHR across ADD must not expand (carry out of the discarded window)"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] a,
  input wire [7:0] b,
  input wire [2:0] c,
  output wire [7:0] x
);
  assign x = (a + b) >> c;
endmodule
EOF
check -assert
