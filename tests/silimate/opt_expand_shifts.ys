# The shape this guard was written for: RTL widens the operand itself, so the sum is
# wide enough not to wrap, and a wider sum is exactly what makes the expansion look
# safe. It is not -- (255 + 1) >> 8 is 1, while (255 >> 8) + (1 >> 8) is 0.
log -header "Negative case: shifted increment of a widened operand must not expand"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [13:0] w,
  input wire [4:0] lv,
  output wire [16:0] x
);
  assign x = ({3'd0, w} + 17'd1) >> lv;
endmodule
EOF
check -assert
equiv_opt -assert opt_shift -expand
design -load postopt
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
design -reset
log -pop



log -header "Negative case: fanout from intermediate wire prevents expansion"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] a,
  input wire [7:0] b,
  input wire [2:0] c,
  output wire [7:0] m,
  output wire [7:0] x
);
  assign m = a & b;
  assign x = m << c;
endmodule
EOF
check -assert
equiv_opt -assert opt_shift -expand
design -load postopt
select -assert-count 1 t:$and
select -assert-count 1 t:$shl
design -reset
log -pop



