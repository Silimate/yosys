design -load postopt
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
design -reset
log -pop



log -header "Negative case: SHR across SUB must not expand (borrow into the retained bits)"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] a,
  input wire [7:0] b,
  input wire [2:0] c,
  output wire [7:0] x
);
  assign x = (a - b) >> c;
endmodule
