# Design test for opt_retime_shift.v: $shl and $shr as cuts. Forward moves only.
#
# No new rule here. reg(A) >> reg(B) equals reg(A >> B) when both are
# registered, so the amount is a data input that merges like a $mux select,
# not a control port that stays put. Both shifts produce zero from the
# all-zero state (checked with opt -full on constant inputs), so the ordinary
# -set-init-zero proof is fair and no init mapping is needed.
#
# This design deliberately has rd read by both shifters. A leftover copy of
# fd is left for the shifter the move does not follow, and a merge of fd into
# another register keeps fd when s_const still reads it. No splitfanout.
#
# s_const, whose amount is a constant, is proved in opt_retime_const.ys: that
# move needs constant-operand support rather than anything about shifts.
#
# Still refused: the signed shifts, pinned at the end.

# ---------------------------------------------------------------------------
log -header "Forward: \$shr entered on the amount, keeping fd for the other shifter"
log -push
design -reset
read_verilog -icells opt_retime_shift.v
hierarchy -top retime_shift
check -assert
# the fanout this design exists for: rd feeds both shifters
select -assert-count 2 w:rd %co c:* %i
select -assert-count 4 t:$dff
design -save orig
opt_retime -flop famt -cut s_var -forward
check -assert
# the amount register survives and absorbs the data register feeding s_var,
# widening from 3 bits to 8 because it now holds the shifter output. fd stays
# for s_const, so the register count is unchanged.
select -assert-count 4 t:$dff
select -assert-count 1 c:fd
select -assert-count 1 c:s_var %x:+[A] w:d %i
select -assert-count 1 c:s_var %x:+[B] w:amt %i
select -assert-count 1 c:s_var %x:+[Y] w:famt_retimed %i
select -assert-count 1 c:famt %x:+[D] w:famt_retimed %i
select -assert-count 1 c:famt %x:+[Q] w:sr %i
select -assert-count 1 c:s_const %x:+[A] w:rd %i
select -assert-count 1 c:fd %x:+[Q] w:rd %i
rename retime_shift gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -set-init-zero -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Forward: \$shr entered on the data, leaving a copy of fd for s_const"
log -push
design -reset
read_verilog -icells opt_retime_shift.v
hierarchy -top retime_shift
check -assert
select -assert-count 4 t:$dff
design -save orig
opt_retime -flop fd -cut s_var -forward
check -assert
# named fd moves onto sr and absorbs famt; a leftover copy keeps rd for s_const
select -assert-count 4 t:$dff
select -assert-count 0 c:famt
select -assert-count 1 c:fd_fanout
select -assert-count 1 c:s_var %x:+[A] w:d %i
select -assert-count 1 c:s_var %x:+[B] w:amt %i
select -assert-count 1 c:fd %x:+[Q] w:sr %i
select -assert-count 1 c:s_const %x:+[A] w:rd %i
select -assert-count 1 c:fd_fanout %x:+[Q] w:rd %i
rename retime_shift gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -set-init-zero -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Forward: \$shl entered on the data, widening the register"
log -push
design -reset
# Inline rather than reusing s_const, whose amount is a constant. No fanout
# here, so this is entered on A, merging the amount, and the only place
# $shl's width growth is proved without a leftover copy.
read_verilog -icells <<EOF
module shiftwide(input clk, input [7:0] a, input [2:0] amt, output [10:0] q);
  wire [7:0] ra;
  wire [2:0] ramt;
  wire [10:0] sl;
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1))  fa   (.CLK(clk), .D(a),   .Q(ra));
  $dff #(.WIDTH(3), .CLK_POLARITY(1'b1))  famt (.CLK(clk), .D(amt), .Q(ramt));
  $shl #(.A_WIDTH(8), .B_WIDTH(3), .Y_WIDTH(11), .A_SIGNED(0), .B_SIGNED(0))
    s0 (.A(ra), .B(ramt), .Y(sl));
  $dff #(.WIDTH(11), .CLK_POLARITY(1'b1)) fq   (.CLK(clk), .D(sl),  .Q(q));
endmodule
EOF
hierarchy -top shiftwide
check -assert
select -assert-count 3 t:$dff
design -save orig
opt_retime -flop fa -cut s0 -forward
check -assert
# fa absorbs famt and widens 8 bits to 11: three registers become two, but the
# register bit count is unchanged at 22, the widening paying for the merge
select -assert-count 2 t:$dff
select -assert-count 0 c:famt
select -assert-count 1 c:s0 %x:+[A] w:a %i
select -assert-count 1 c:s0 %x:+[B] w:amt %i
select -assert-count 1 c:fa %x:+[Q] w:sl %i
rename shiftwide gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -set-init-zero -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# $shl and $shr are in, their signed counterparts are not. $sshr differs in
# what it does with the vacated high bits, not in its port list, so it obeys
# the same rule and is one entry away; it stays out until something proves it.
# This pins where shift support currently stops.
#
# logger -expect error exits yosys successfully, so it has to come last.
design -reset
read_verilog -icells <<EOF
module signedshift(input clk, input [7:0] a, input [2:0] amt, output [7:0] q);
  wire [7:0] ra, y;
  wire [2:0] ramt;
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fa   (.CLK(clk), .D(a),   .Q(ra));
  $dff #(.WIDTH(3), .CLK_POLARITY(1'b1)) famt (.CLK(clk), .D(amt), .Q(ramt));
  $sshr #(.A_WIDTH(8), .B_WIDTH(3), .Y_WIDTH(8), .A_SIGNED(1), .B_SIGNED(0))
    s0 (.A(ra), .B(ramt), .Y(y));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fq   (.CLK(clk), .D(y),   .Q(q));
endmodule
EOF
hierarchy -top signedshift
check -assert
logger -expect error "Cut cell s0 has type \$sshr, which opt_retime cannot move across yet" 1
opt_retime -flop fa -cut s0 -forward
