# Tests for opt_addcmp.

# ---------------------------------------------------------------------------
log -header "Functional equivalence: all four relations, sum on the left"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [11:0] a, input [11:0] b, input [12:0] c, output [3:0] y);
  wire [12:0] s = a + b;
  assign y = {s >= c, s > c, s <= c, s < c};
endmodule
EOF
proc; opt_clean
rename ac gold

read_verilog -sv <<EOF
module ac(input [11:0] a, input [11:0] b, input [12:0] c, output [3:0] y);
  wire [12:0] s = a + b;
  assign y = {s >= c, s > c, s <= c, s < c};
endmodule
EOF
proc; opt_clean
opt_addcmp -timing ac
opt_clean ac
rename ac gate

miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt; memory; opt
sat -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
