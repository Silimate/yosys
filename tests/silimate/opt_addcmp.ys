# ---------------------------------------------------------------------------
# -decode: `onehot << sum` as carry-save equality banks. Each case keeps the
# original as `gold`, rewrites `ac` and proves the two equal.

# ---------------------------------------------------------------------------
log -header "Decode: 1 << (a + b), adder and shifter both gone"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [4:0] a, input [4:0] b, output [63:0] y);
  wire [5:0] s = a + b;
  assign y = 64'h1 << s;
endmodule
EOF
proc; opt_clean
copy ac gold
opt_addcmp -decode ac
opt_clean ac
select -assert-count 0 ac/t:$shl
select -assert-count 0 ac/t:$add
miter -equiv -flatten -make_assert gold ac miter
hierarchy -top miter
proc; opt; memory; opt
sat -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Decode: three summands and a split constant subtract, mod 2**W"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [4:0] a, input [3:0] b, input [2:0] c, output [31:0] y);
  wire [6:0] s = a + b + c;
  wire [6:0] amt = {s[6:3] - 4'd1, s[2:0]};   // s - 8, as const folding splits it
  assign y = 32'h1 << amt;
endmodule
EOF
proc; opt_clean
copy ac gold
opt_addcmp -decode ac
opt_clean ac
select -assert-count 0 ac/t:$shl
select -assert-count 0 ac/t:$sub
miter -equiv -flatten -make_assert gold ac miter
hierarchy -top miter
proc; opt; memory; opt
sat -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Decode: muxes above the amount are pushed, constant arm folds"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [4:0] a, input [4:0] b, input [4:0] c, input g, input m, output [31:0] y);
  wire [6:0] s = a + b;
  wire [6:0] lo = (s > 7'd12) ? s - 7'd8 : 7'd4;
  wire [6:0] amt = m ? lo : a + c;
  assign y = 32'h1 << amt;
endmodule
EOF
proc; opt_clean
copy ac gold
logger -expect log "decoded as 2 carry-save equality bank\(s\) below 2 mux\(es\)" 1
opt_addcmp -decode ac
logger -check-expected
opt_clean ac
select -assert-count 0 ac/t:$shl
miter -equiv -flatten -make_assert gold ac miter
hierarchy -top miter
proc; opt; memory; opt
sat -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Decode: a mux summand with a late select goes below the decode"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [3:0] x, input [3:0] z, input [3:0] d, input en, output [31:0] y);
  wire sel = en & (x > z);   // decided by the arms themselves, so later than both
  wire [4:0] t = sel ? z : x;
  wire [5:0] amt = t + d - 6'd8;
  assign y = 32'h1 << amt;
endmodule
EOF
proc; opt_clean
copy ac gold
logger -expect log "decoded as 2 carry-save equality bank\(s\) below 1 mux\(es\)" 1
opt_addcmp -decode ac
logger -check-expected
opt_clean ac
miter -equiv -flatten -make_assert gold ac miter
hierarchy -top miter
proc; opt; memory; opt
sat -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Decode: a mux summand with an early select stays a summand"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [3:0] x, input [3:0] z, input [3:0] d, input en, output [31:0] y);
  wire [4:0] t = en ? z : x;
  wire [5:0] amt = t + d;
  assign y = 32'h1 << amt;
endmodule
EOF
proc; opt_clean
copy ac gold
logger -expect log "decoded as 1 carry-save equality bank\(s\) below 0 mux\(es\)" 1
opt_addcmp -decode ac
logger -check-expected
opt_clean ac
miter -equiv -flatten -make_assert gold ac miter
hierarchy -top miter
proc; opt; memory; opt
sat -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Decode: a narrow chained add is opened once its bound shows no wrap"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [4:0] a, input [3:0] b, input [2:0] c, input [3:0] d, output [31:0] y);
  wire [5:0] t = a + b + c;   // 31 + 15 + 7 fits 6 bits, which widths alone cannot show
  wire [6:0] s = t + d;
  assign y = 32'h1 << s;
endmodule
EOF
proc; opt_clean
copy ac gold
opt_addcmp -decode ac
opt_clean ac
select -assert-count 0 ac/t:$add
miter -equiv -flatten -make_assert gold ac miter
hierarchy -top miter
proc; opt; memory; opt
sat -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Decode: a narrow add that can wrap stays a summand"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [3:0] a, input [3:0] b, input [3:0] c, output [31:0] y);
  wire [3:0] t = a + b;   // wraps, so a + b is not what the decode sees
  wire [4:0] s = t + c;
  assign y = 32'h1 << s;
endmodule
EOF
proc; opt_clean
copy ac gold
opt_addcmp -decode ac
opt_clean ac
select -assert-count 0 ac/t:$shl
select -assert-count 1 ac/t:$add
miter -equiv -flatten -make_assert gold ac miter
hierarchy -top miter
proc; opt; memory; opt
sat -prove-asserts -verify
design -reset
log -pop

