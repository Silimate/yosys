# ---------------------------------------------------------------------------
log -header "Decode negative: a popcount is already a compressor tree"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [7:0] v, output [15:0] y);
  wire [1:0] p0 = v[0] + v[1], p1 = v[2] + v[3], p2 = v[4] + v[5], p3 = v[6] + v[7];
  wire [2:0] q0 = p0 + p1, q1 = p2 + p3;
  wire [3:0] n = q0 + q1;   // balanced and narrow: carry-save levels only add depth
  assign y = 16'h1 << n;
endmodule
EOF
proc; opt_clean
opt_addcmp -decode
select -assert-count 1 t:$shl
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Decode negative: one live output is a single sum == k"
log -push
design -reset
read_verilog -sv <<EOF
module ac(input [4:0] a, input [4:0] b, input [31:0] alt, input m, output y);
  wire [5:0] s = a + b;
  wire [31:0] w = m ? (32'h1 << s) : alt;   // only bit 0 of the mux is read onward
  assign y = w[0];
endmodule
EOF
proc; opt_clean
opt_addcmp -decode
select -assert-count 1 t:$shl
design -reset
log -pop

