# Reset values folded through a move.
#
# A reset value travels the same way an init value does, and for the same
# reason: reset ? f(RSTVAL) : f(x) is f of reset ? RSTVAL : x, so it is enough
# for the register left behind to reset to f(RSTVAL). The pass evaluates the
# chain on constants to find that value, exactly as it does for an init.
#
# What resets add over init values is that the merged registers need not agree
# on the value. They do have to agree on when they reset, because a register
# resetting while another loads would feed the cut a mix the single surviving
# register could not reproduce, so the net and polarity are compared. The
# values are then folded together: two registers resetting to 8'h03 and 8'h04
# on the same net merge into one resetting to 8'h07.
#
# They also add a case init values never reach. The single-bit cells spell the
# value they reset to into the type name, so folding it can change which cell
# the register has to be, and $_SDFF_PP0_ has to come back as $_SDFF_PP1_.
# Section 2 is there for that.
#
# Every register here starts at its own reset value. That is what real hardware
# does, and the proof needs it: miter -make_assert compares cycle 0, which is
# decided by the init values rather than by the reset, so leaving the two
# unrelated would make the comparison turn on something the reset fold has
# nothing to do with. The reset net is free stimulus, so the proof still covers
# every cycle it is and is not asserted on.

# ---------------------------------------------------------------------------
log -header "Forward: sync reset values folded, including two that differ"
log -push
design -reset
read_verilog -icells <<EOF
module rstfold(input clk, rst, input [7:0] a, b, c, output [7:0] qn, qs);
  (* init = 8'h00 *) wire [7:0] rn;
  (* init = 8'h03 *) wire [7:0] ra;
  (* init = 8'h04 *) wire [7:0] rb;
  wire [7:0] n, s;
  $sdff #(.WIDTH(8), .CLK_POLARITY(1'b1), .SRST_POLARITY(1'b1), .SRST_VALUE(8'h00))
    fn (.CLK(clk), .SRST(rst), .D(a), .Q(rn));
  $not #(.A_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0)) n0 (.A(rn), .Y(n));
  $sdff #(.WIDTH(8), .CLK_POLARITY(1'b1), .SRST_POLARITY(1'b1), .SRST_VALUE(8'h00))
    fqn (.CLK(clk), .SRST(rst), .D(n), .Q(qn));
  $sdff #(.WIDTH(8), .CLK_POLARITY(1'b1), .SRST_POLARITY(1'b1), .SRST_VALUE(8'h03))
    fa (.CLK(clk), .SRST(rst), .D(b), .Q(ra));
  $sdff #(.WIDTH(8), .CLK_POLARITY(1'b1), .SRST_POLARITY(1'b1), .SRST_VALUE(8'h04))
    fb (.CLK(clk), .SRST(rst), .D(c), .Q(rb));
  $add #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    a0 (.A(ra), .B(rb), .Y(s));
  $sdff #(.WIDTH(8), .CLK_POLARITY(1'b1), .SRST_POLARITY(1'b1), .SRST_VALUE(8'h00))
    fqs (.CLK(clk), .SRST(rst), .D(s), .Q(qs));
endmodule
EOF
hierarchy -top rstfold
setattr -set init 8'h00 w:qn w:qs
check -assert
select -assert-count 5 t:$sdff
design -save orig
opt_retime -flop fn -cut n0 -forward
opt_retime -flop fa -cut a0 -forward
check -assert
select -assert-count 4 t:$sdff
select -assert-count 0 c:fb
# Asserted directly, because a sequential proof only pins a reset value down on
# the cycles its stimulus actually asserts the reset, and a fold that is never
# exercised is a fold that can be wrong and still pass.
select -assert-count 1 c:fn r:SRST_VALUE=8'hff %i
select -assert-count 1 c:fa r:SRST_VALUE=8'h07 %i
# the init values fold alongside, onto the registers' new Q nets
select -assert-count 1 w:n a:init=8'hff %i
select -assert-count 1 w:s a:init=8'h07 %i
select -assert-count 0 w:rn a:init %i
select -assert-count 0 w:ra a:init %i
select -assert-count 0 w:rb a:init %i
rename rstfold gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Forward: a single-bit register whose folded reset changes its type"
log -push
design -reset
read_verilog -icells <<EOF
module finerst(input clk, rst, d, output q);
  (* init = 1'b0 *) wire r0;
  wire n;
  $_SDFF_PP0_ ff (.C(clk), .R(rst), .D(d), .Q(r0));
  $not #(.A_WIDTH(1), .Y_WIDTH(1), .A_SIGNED(0)) n0 (.A(r0), .Y(n));
  $_SDFF_PP0_ fq (.C(clk), .R(rst), .D(n), .Q(q));
endmodule
EOF
hierarchy -top finerst
setattr -set init 1'b0 w:q
check -assert
select -assert-count 2 t:$_SDFF_PP0_
design -save orig
opt_retime -flop ff -cut n0 -forward
check -assert
# ff resets to 1 now, and for a single-bit cell that is not a parameter change
# but a different cell type. fq is untouched and still resets to 0.
select -assert-count 1 t:$_SDFF_PP1_
select -assert-count 1 t:$_SDFF_PP0_
select -assert-count 1 c:ff t:$_SDFF_PP1_ %i
select -assert-count 1 c:fq t:$_SDFF_PP0_ %i
select -assert-count 1 w:n a:init=1'b1 %i
select -assert-count 0 w:r0 a:init %i
rename finerst gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "Forward: an async reset value folded through a merge"
log -push
design -reset
read_verilog -icells <<EOF
module arstfold(input clk, rst, input [7:0] a, b, output [7:0] q);
  (* init = 8'h0a *) wire [7:0] ra;
  (* init = 8'h05 *) wire [7:0] rb;
  wire [7:0] s;
  $adff #(.WIDTH(8), .CLK_POLARITY(1'b1), .ARST_POLARITY(1'b1), .ARST_VALUE(8'h0a))
    fa (.CLK(clk), .ARST(rst), .D(a), .Q(ra));
  $adff #(.WIDTH(8), .CLK_POLARITY(1'b1), .ARST_POLARITY(1'b1), .ARST_VALUE(8'h05))
    fb (.CLK(clk), .ARST(rst), .D(b), .Q(rb));
  $or #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    o0 (.A(ra), .B(rb), .Y(s));
  $adff #(.WIDTH(8), .CLK_POLARITY(1'b1), .ARST_POLARITY(1'b1), .ARST_VALUE(8'h0f))
    fq (.CLK(clk), .ARST(rst), .D(s), .Q(q));
endmodule
EOF
hierarchy -top arstfold
setattr -set init 8'h0f w:q
check -assert
select -assert-count 3 t:$adff
design -save orig
opt_retime -flop fa -cut o0 -forward
check -assert
select -assert-count 2 t:$adff
select -assert-count 0 c:fb
# 8'h0a | 8'h05 is 8'h0f: an async reset folds through the merge the same way a
# sync one does, the difference being only when the register loads the value
select -assert-count 1 c:fa r:ARST_VALUE=8'h0f %i
select -assert-count 1 w:s a:init=8'h0f %i
select -assert-count 0 w:ra a:init %i
select -assert-count 0 w:rb a:init %i
rename arstfold gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
# sat has no model for an async reset, so the reset is turned into ordinary
# logic first. It runs on the assembled miter, so gold and gate get the same
# treatment and the comparison stays a fair one.
async2sync
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# logger -expect error exits yosys successfully, so this has to come last.
#
# The values may differ but the timing may not. fb resets on rst2 while fa
# resets on rst, so on a cycle where one fires and the other does not the cut
# sees one operand reset and the other loaded, and no single register can
# stand in for that. Compare with the section above, where the same pair of
# registers merged happily with different values on one net.
log -header "Refused: merged registers that reset on different nets"
log -push
design -reset
read_verilog -icells <<EOF
module rstmix(input clk, rst, rst2, input [7:0] a, b, output [7:0] q);
  wire [7:0] ra, rb, s;
  $sdff #(.WIDTH(8), .CLK_POLARITY(1'b1), .SRST_POLARITY(1'b1), .SRST_VALUE(8'h03))
    fa (.CLK(clk), .SRST(rst), .D(a), .Q(ra));
  $sdff #(.WIDTH(8), .CLK_POLARITY(1'b1), .SRST_POLARITY(1'b1), .SRST_VALUE(8'h04))
    fb (.CLK(clk), .SRST(rst2), .D(b), .Q(rb));
  $add #(.A_WIDTH(8), .B_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0), .B_SIGNED(0))
    a0 (.A(ra), .B(rb), .Y(s));
  $sdff #(.WIDTH(8), .CLK_POLARITY(1'b1), .SRST_POLARITY(1'b1), .SRST_VALUE(8'h00))
    fq (.CLK(clk), .SRST(rst), .D(s), .Q(q));
endmodule
EOF
hierarchy -top rstmix
check -assert
logger -expect error "Flop fb on input B of cell a0 has a different sync reset than flop fa" 1
opt_retime -flop fa -cut a0 -forward
