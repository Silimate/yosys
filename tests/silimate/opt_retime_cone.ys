# -cone: a forward move across the whole combinational fan-in of the cut.
#
# pend[idx] reaches the pass as one $bmux, and bmuxmap and pmuxtree then take
# it apart into a tree of $mux cells whose selects are $eq cells decoding idx.
# idx reaches the output of that tree along several paths, and pend along
# several more, so no single chain from the register gets there. Every input
# to the tree is still a register sharing the flop's clock and controls, which
# is all the move needs: one register on the tree's output replaces them.

# ---------------------------------------------------------------------------
# word_reg_multipath's shape: one word register and its index, both loaded on
# rtr, selecting a bit that then meets module inputs on the way to r.
log -header "Cone: across a decoded mux tree"
log -push
design -reset
read_verilog -icells <<EOF
module wordsel(input clk, resetb, rtr, input [3:0] pre_pend, input [1:0] pre_idx,
               input [2:0] d, output r);
  wire [3:0] pend;
  wire [1:0] idx;
  wire s0, s2, s3, sor, m0, m1, hit, t0, t1;
  $sdffe #(.WIDTH(4), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1), .SRST_POLARITY(1'b0),
           .SRST_VALUE(4'b1111))
    pend_reg (.CLK(clk), .EN(rtr), .SRST(resetb), .D(pre_pend), .Q(pend));
  $sdffe #(.WIDTH(2), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1), .SRST_POLARITY(1'b0),
           .SRST_VALUE(2'b00))
    idx_reg (.CLK(clk), .EN(rtr), .SRST(resetb), .D(pre_idx), .Q(idx));
  $eq #(.A_WIDTH(2), .B_WIDTH(2), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    e0 (.A(idx), .B(2'b01), .Y(s0));
  $eq #(.A_WIDTH(2), .B_WIDTH(2), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    e2 (.A(idx), .B(2'b10), .Y(s2));
  $eq #(.A_WIDTH(2), .B_WIDTH(2), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    e3 (.A(idx), .B(2'b11), .Y(s3));
  $or #(.A_WIDTH(1), .B_WIDTH(1), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    o0 (.A(s2), .B(s3), .Y(sor));
  $mux #(.WIDTH(1)) mx0 (.A(pend[0]), .B(pend[1]), .S(s0), .Y(m0));
  $mux #(.WIDTH(1)) mx1 (.A(pend[2]), .B(pend[3]), .S(s3), .Y(m1));
  $mux #(.WIDTH(1)) mx2 (.A(m0), .B(m1), .S(sor), .Y(hit));
  $and #(.A_WIDTH(1), .B_WIDTH(1), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    a0 (.A(hit), .B(d[0]), .Y(t0));
  $xor #(.A_WIDTH(1), .B_WIDTH(1), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    x0 (.A(t0), .B(d[1]), .Y(t1));
  $or #(.A_WIDTH(1), .B_WIDTH(1), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    o1 (.A(t1), .B(d[2]), .Y(r));
endmodule
EOF
hierarchy -top wordsel
check -assert
setattr -set init 4'b1010 w:pend
setattr -set init 2'b01 w:idx
design -save orig

# With -no-cone the chain walk forks at the three comparators straight away
opt_retime -flop idx_reg -cut o1 -forward -no-cone
scratchpad -assert opt_retime.moved false
select -assert-count 2 t:$sdffe

# With it, the cut is past d, so the move stops at the last cell whose fan-in
# is all registers: the tree's output, hit.
opt_retime -flop idx_reg -cut o1 -forward -cone
scratchpad -assert opt_retime.moved true
scratchpad -assert opt_retime.cut mx2
check -assert
# nothing else read pend or idx, so both went into the one register, which
# takes the flop's name
select -assert-count 1 t:$sdffe
select -assert-count 1 c:idx_reg %x:+[Q] w:hit %i
select -assert-count 1 c:a0 %x:+[A] w:hit %i
# idx is 1, so hit starts as pend[1]; the reset loads pend[0] of 4'b1111
select -assert-count 1 w:hit a:init=1'1 %i
select -assert-count 1 c:idx_reg r:SRST_VALUE=1'1 %i
rename wordsel gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# The same tree with one of its cells read from outside it. That cell and what
# feeds it stay for the outside reader, and the move copies them.
log -header "Cone: a cell of the cone read from outside it is copied"
log -push
design -reset
read_verilog -icells <<EOF
module wordtap(input clk, rtr, input [3:0] pre_pend, input [1:0] pre_idx,
               input d, output r, output lo);
  wire [3:0] pend;
  wire [1:0] idx;
  wire s0, s2, s3, sor, m0, m1, hit;
  $dffe #(.WIDTH(4), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    pend_reg (.CLK(clk), .EN(rtr), .D(pre_pend), .Q(pend));
  $dffe #(.WIDTH(2), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    idx_reg (.CLK(clk), .EN(rtr), .D(pre_idx), .Q(idx));
  $eq #(.A_WIDTH(2), .B_WIDTH(2), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    e0 (.A(idx), .B(2'b01), .Y(s0));
  $eq #(.A_WIDTH(2), .B_WIDTH(2), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    e2 (.A(idx), .B(2'b10), .Y(s2));
  $eq #(.A_WIDTH(2), .B_WIDTH(2), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    e3 (.A(idx), .B(2'b11), .Y(s3));
  $or #(.A_WIDTH(1), .B_WIDTH(1), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    o0 (.A(s2), .B(s3), .Y(sor));
  $mux #(.WIDTH(1)) mx0 (.A(pend[0]), .B(pend[1]), .S(s0), .Y(m0));
  $mux #(.WIDTH(1)) mx1 (.A(pend[2]), .B(pend[3]), .S(s3), .Y(m1));
  $mux #(.WIDTH(1)) mx2 (.A(m0), .B(m1), .S(sor), .Y(hit));
  $and #(.A_WIDTH(1), .B_WIDTH(1), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    a0 (.A(hit), .B(d), .Y(r));
  assign lo = m0;
endmodule
EOF
hierarchy -top wordtap
check -assert
setattr -set init 4'b0110 w:pend
setattr -set init 2'b10 w:idx
design -save orig
opt_retime -flop idx_reg -cut mx2 -forward -cone
scratchpad -assert opt_retime.moved true
scratchpad -assert opt_retime.cut mx2
check -assert
# lo still reads m0 off the original mx0, which still reads both registers
select -assert-count 3 t:$dffe
select -assert-count 1 c:idx_reg_retimed %x:+[Q] w:hit %i
select -assert-count 1 c:mx0 %x:+[Y] w:m0 %i
rename wordtap gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# array_elem_shared_cut's shape: two slots, each a word and its index loaded on
# its own rtr bit, OR'd together before meeting a module input. The slots'
# enables differ, so reaching the OR means lowering them, which the pass does
# unless told not to.
log -header "Cone: two slots with different enables, lowered"
log -push
design -reset
read_verilog -icells <<EOF
module slots(input clk, input [1:0] rtr, input [3:0] pp0, pp1, input [1:0] pi0, pi1,
             input d, output r);
  wire [3:0] pend0, pend1;
  wire [1:0] idx0, idx1;
  wire [1:0] hit;
  wire any;
  $dffe #(.WIDTH(4), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    pend0_reg (.CLK(clk), .EN(rtr[0]), .D(pp0), .Q(pend0));
  $dffe #(.WIDTH(2), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    idx0_reg (.CLK(clk), .EN(rtr[0]), .D(pi0), .Q(idx0));
  $dffe #(.WIDTH(4), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    pend1_reg (.CLK(clk), .EN(rtr[1]), .D(pp1), .Q(pend1));
  $dffe #(.WIDTH(2), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    idx1_reg (.CLK(clk), .EN(rtr[1]), .D(pi1), .Q(idx1));
  $bmux #(.WIDTH(1), .S_WIDTH(2)) b0 (.A(pend0), .S(idx0), .Y(hit[0]));
  $bmux #(.WIDTH(1), .S_WIDTH(2)) b1 (.A(pend1), .S(idx1), .Y(hit[1]));
  $reduce_or #(.A_WIDTH(2), .Y_WIDTH(1), .A_SIGNED(0)) ro (.A(hit), .Y(any));
  $and #(.A_WIDTH(1), .B_WIDTH(1), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    a0 (.A(any), .B(d), .Y(r));
endmodule
EOF
hierarchy -top slots
check -assert
setattr -set init 4'b0001 w:pend0
setattr -set init 4'b1000 w:pend1
setattr -set init 2'b00 w:idx0
setattr -set init 2'b11 w:idx1
design -save orig
opt_retime -flop idx1_reg -cut a0 -forward -cone
scratchpad -assert opt_retime.moved true
scratchpad -assert opt_retime.cut ro
check -assert
# the lowered registers stay, each holding through its own mux, and the move
# adds one register on the OR
select -assert-count 5 t:$dff
select -assert-count 1 t:$dff %x:+[Q] w:any %i
rename slots gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
# Told not to lower, the OR is out of reach, and the move stops at the named
# slot's own select.
log -header "Cone: two slots with different enables, not lowered"
log -push
design -reset
read_verilog -icells <<EOF
module slots(input clk, input [1:0] rtr, input [3:0] pp0, pp1, input [1:0] pi0, pi1,
             input d, output r);
  wire [3:0] pend0, pend1;
  wire [1:0] idx0, idx1;
  wire [1:0] hit;
  wire any;
  $dffe #(.WIDTH(4), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    pend0_reg (.CLK(clk), .EN(rtr[0]), .D(pp0), .Q(pend0));
  $dffe #(.WIDTH(2), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    idx0_reg (.CLK(clk), .EN(rtr[0]), .D(pi0), .Q(idx0));
  $dffe #(.WIDTH(4), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    pend1_reg (.CLK(clk), .EN(rtr[1]), .D(pp1), .Q(pend1));
  $dffe #(.WIDTH(2), .CLK_POLARITY(1'b1), .EN_POLARITY(1'b1))
    idx1_reg (.CLK(clk), .EN(rtr[1]), .D(pi1), .Q(idx1));
  $bmux #(.WIDTH(1), .S_WIDTH(2)) b0 (.A(pend0), .S(idx0), .Y(hit[0]));
  $bmux #(.WIDTH(1), .S_WIDTH(2)) b1 (.A(pend1), .S(idx1), .Y(hit[1]));
  $reduce_or #(.A_WIDTH(2), .Y_WIDTH(1), .A_SIGNED(0)) ro (.A(hit), .Y(any));
  $and #(.A_WIDTH(1), .B_WIDTH(1), .Y_WIDTH(1), .A_SIGNED(0), .B_SIGNED(0))
    a0 (.A(any), .B(d), .Y(r));
endmodule
EOF
hierarchy -top slots
check -assert
setattr -set init 4'b0001 w:pend0
setattr -set init 4'b1000 w:pend1
setattr -set init 2'b00 w:idx0
setattr -set init 2'b11 w:idx1
design -save orig
opt_retime -flop idx1_reg -cut a0 -forward -cone -no-lower-controls
scratchpad -assert opt_retime.moved true
scratchpad -assert opt_retime.cut b1
check -assert
# slot 1's two registers became one on hit[1]; slot 0 is untouched
select -assert-count 3 t:$dffe
select -assert-count 1 c:idx1_reg %x:+[EN] w:rtr %i
select -assert-count 1 c:idx1_reg %x:+[Q] w:hit %i
rename slots gate
design -import orig -as gold
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt
sat -seq 8 -prove-asserts -verify
design -reset
log -pop

# ---------------------------------------------------------------------------
log -header "-cone is forward only"
design -reset
read_verilog -icells <<EOF
module back(input clk, input [7:0] a, output [7:0] q);
  wire [7:0] t;
  $not #(.A_WIDTH(8), .Y_WIDTH(8), .A_SIGNED(0)) n0 (.A(a), .Y(t));
  $dff #(.WIDTH(8), .CLK_POLARITY(1'b1)) fq (.CLK(clk), .D(t), .Q(q));
endmodule
EOF
hierarchy -top back
logger -expect error "-cone only applies to -forward moves" 1
opt_retime -flop fq -cut n0 -backward -cone
