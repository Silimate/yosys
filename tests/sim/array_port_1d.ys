# Unpacked array ports split into element wires, replayed from every way a dump holds them.
# Generated by array_port_gen.py; -sim-cmp fails on any element bound to the wrong bits, and
# an element that does not bind at all is fatal.
read_verilog array_port.v
prep -top array_port_1d

# Control: one vector per element, index in the name (`coeffs[-1] [2:0]`)
sim -r array_port_1d_elements.vcd -scope tb.dut -sim-cmp -q

# Flattened into 1-bit vars (`coeffs [8]`..`coeffs [0]`): negative and offset bounds, both
# declared directions
sim -r array_port_1d_bits.vcd -scope tb.dut -sim-cmp -q

# Flattened into one vector (`coeffs [8:0]`)
sim -r array_port_1d_vector.vcd -scope tb.dut -sim-cmp -q

# Same binding on the multi-root -instance path Preqorsor's parallel replay uses
sim -r array_port_1d_bits.vcd -instance array_port_1d:tb.dut -sim-cmp -q
