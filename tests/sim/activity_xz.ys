# Duty is a fraction of the time a bit was actually driven, not of the whole window.
#
# activity_xz.vcd (see activity_xz_gen.py) is a 128-cycle 1GHz window in which two
# signals go unknown partway through, the way a dump does across a `$dumpoff`/`$dumpon`
# pair or a bit an upstream tool never drove. Every unknown stretch starts and ends on a
# sample, so the numbers below are exact:
#
#          known time    high time    duty      measured over the whole window instead
#   clk    128_000_000   64_000_000   0.500     0.500  (unaffected: never unknown)
#   held    88_000_000   88_000_000   1.000     0.687500
#   gated   64_000_000   32_000_000   0.500     0.250
#   dark             0            0   0.000     0.000
#
# `held` and `gated` are what separate the two definitions. Counting unknown ticks as
# time spent low scales duty down by exactly the fraction of the window that was dark,
# while activity keeps dividing by a cycle count the hole does not touch -- so the pair
# stops satisfying `activity <= min(duty, 1 - duty)` and stops describing one waveform.
#
# `dark` is the degenerate case: known time is zero, so there is no duty to report. It
# pins the guard that keeps that from dividing by zero and annotating nan.

read_verilog activity_xz.v
prep -top activity_xz

# $ACKT/$DUTY hold a space-separated per-bit list, hence the trailing glob.

sim -r activity_xz.vcd -scope tb.uut -activity -q
select -assert-any A:$DURATION=128000000
select -assert-any A:$FREQUENCY=1000000000.000000

# Fully known: same answer under either definition.
select -assert-count 1 w:clk a:$ACKT=1.000000* %i
select -assert-count 1 w:clk a:$DUTY=0.500000* %i

# High on both sides of a 40M-tick hole: high for all of the time it was driven.
select -assert-count 1 w:held a:$DUTY=1.000000* %i
select -assert-none w:held a:$DUTY=0.687500* %i

# Half high over the 64M ticks it was driven, then unknown for the rest of the window.
select -assert-count 1 w:gated a:$DUTY=0.500000* %i
select -assert-none w:gated a:$DUTY=0.250000* %i

# Never driven: no known time to take a fraction of. Asserting the exact 0.000000 is
# what pins the guard -- dividing by a zero known time annotates nan, which matches
# neither this nor any other expected value.
select -assert-count 1 w:dark a:$DUTY=0.000000* %i
select -assert-count 1 w:dark a:$ACKT=0.000000* %i
