# Input shapes that bound before array elements were understood, generated by
# array_port_gen.py: a same-name vector, bit-blasted bits, a tied-off pin (sim_const), a
# slice of another scope's vector (sim_src/sim_src_bit), and `\din[1]` / `\part[1][1]` whose
# siblings are not ports here, so they bind as 0-based words by their last index: din[8]..din[15]
# and part[1][4]..part[1][7] of the 1-bit dumps.
read_verilog array_port.v
prep -top array_port_controls
sim -r array_port_controls.vcd -scope tb.dut -sim-cmp -q
