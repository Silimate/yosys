# 2-D array port `logic [3:0] grid [1:0][-1:1]` split into `\grid[1][-1]`..`\grid[0][1]`,
# replayed from every way a dump holds it. Generated by array_port_gen.py; -sim-cmp fails on
# any element bound to the wrong bits, and an element that does not bind at all is fatal.
read_verilog array_port.v
prep -top array_port_2d

# One vector per element, indices in the name (`grid[1][-1] [3:0]`)
sim -r array_port_2d_elements.vcd -scope tb.dut -sim-cmp -q

# One vector per element, indices in the range (`grid [1][-1][3:0]`)
sim -r array_port_2d_ranges.vcd -scope tb.dut -sim-cmp -q

# A scope per outer index holding elements named by index (`grid[1]` / `[-1] [3:0]`)
sim -r array_port_2d_scopes.vcd -scope tb.dut -sim-cmp -q

# Flattened into 1-bit vars (`grid [23]`..`grid [0]`)
sim -r array_port_2d_bits.vcd -scope tb.dut -sim-cmp -q

# Flattened into one vector (`grid [23:0]`)
sim -r array_port_2d_vector.vcd -scope tb.dut -sim-cmp -q

# Each outer element flattened on its own: `grid[1] [11:0]` as a vector, `grid[0] [k]` as bits
sim -r array_port_2d_rows.vcd -scope tb.dut -sim-cmp -q
sim -r array_port_2d_rows.vcd -instance array_port_2d:tb.dut -sim-cmp -q
