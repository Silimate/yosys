read_verilog <<EOT
module equiv_double_neg(
	input [3:0] a, b, c,
	output [4:0] y
);
	wire [3:0] ab = a - b;
	assign y = c - ab;
endmodule
EOT
hierarchy -auto-top
proc
equiv_opt -assert arith_tree
design -reset

# A chain link that is narrower than the cell consuming it truncates its own
# result, and that truncation is observable in the wider consumer. Flattening
# the chain must not recover the carry the narrower link discarded.
read_verilog <<EOT
module equiv_narrow_intermediate(
	input [7:0] a, b, c,
	output [8:0] y
);
	wire [7:0] t = a + b;
	assign y = t + c;
endmodule
EOT
hierarchy -auto-top
proc
equiv_opt -assert arith_tree
# t is 8 bits wide and a + b needs 9, so the truncation is observable to the
# 9-bit consumer and the chain must stay unflattened.
design -load postopt
select -assert-count 0 t:$fa
select -assert-count 2 t:$add
design -reset

read_verilog <<EOT
module equiv_narrow_intermediate_no_overflow(
	input [7:0] a, b,
	input [8:0] c,
	output [9:0] y
);
	wire [8:0] t = a + b;
	assign y = t + c;
endmodule
EOT
hierarchy -auto-top
proc
equiv_opt -assert arith_tree
# Same shape, but t is wide enough to hold any 8-bit sum, so it never truncates
# and the narrower link is still free to flatten into the wider consumer.
design -load postopt
select -assert-count 1 t:$fa
select -assert-count 1 t:$add
design -reset

# Only the truncating link must be excluded: with a truncated t entering the
# wider (t+c+d) chain as a leaf, the wide part still folds into a tree and the
# whole result stays equivalent.
read_verilog <<EOT
module equiv_trunc_mixed(
	input [7:0] a, b, c, d,
	output [9:0] y
);
	wire [7:0] t = a + b;
	assign y = t + c + d;
endmodule
EOT
hierarchy -auto-top
proc
equiv_opt -assert arith_tree
design -load postopt
select -assert-min 1 t:$fa
design -reset

# A link narrower than its width rule asks for can still never truncate when its
# operands' own bounds say so: s holds at most 254, so s + c fits in 8 bits for a
# one-bit c, and the whole sum folds into one tree.
read_verilog <<EOT
module equiv_bounded_link(
	input [6:0] a, b,
	input c,
	input [9:0] d,
	output [9:0] y
);
	wire [7:0] s = a + b;
	wire [7:0] t = s + c;
	assign y = t + d;
endmodule
EOT
hierarchy -auto-top
proc
equiv_opt -assert arith_tree
design -load postopt
select -assert-min 1 t:$fa
select -assert-count 1 t:$add
design -reset

# The same link left a bit wider with only its low 8 bits read, which is how
# opt_signif leaves it: the unread top bit is always zero, so it drops nothing.
read_verilog <<EOT
module equiv_bounded_link_unread_top(
	input [6:0] a, b,
	input c,
	input [9:0] d,
	output [9:0] y
);
	wire [7:0] s = a + b;
	wire [8:0] t = s + c;
	assign y = t[7:0] + d;
endmodule
EOT
hierarchy -auto-top
proc
equiv_opt -assert arith_tree
design -load postopt
select -assert-min 1 t:$fa
select -assert-count 1 t:$add
design -reset

# With a two-bit c the link can reach 257, so its truncation is observable and it
# must stay out of the tree.
read_verilog <<EOT
module equiv_bounded_link_overflow(
	input [6:0] a, b,
	input [1:0] c,
	input [9:0] d,
	output [9:0] y
);
	wire [7:0] s = a + b;
	wire [7:0] t = s + c;
	assign y = t + d;
endmodule
EOT
hierarchy -auto-top
proc
equiv_opt -assert arith_tree
design -load postopt
select -assert-count 2 t:$add
design -reset
