# Columns 2-3 hold only a and b with nothing carried in, so they pass through without a half adder
read_verilog <<EOT
module rows(input [7:0] a, b, c, output [7:0] y);
	assign y = a + (b << 2) + (c << 4);
endmodule
EOT
hierarchy -auto-top
proc
opt_expr
opt_clean
equiv_opt -assert arith_tree
design -load postopt
select -assert-count 1 t:$fa
select -assert-none t:$xor t:$and %u
